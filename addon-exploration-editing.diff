+using System.Data;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed partial class AddonsTab
+{
+    private Dictionary<string, AddonExplorationRow> _explorationRows = new(StringComparer.OrdinalIgnoreCase);
+    private Dictionary<string, string?> _stagedExploration = new(StringComparer.OrdinalIgnoreCase);
+    private readonly ComboBox _explorationValue = new() { DropDownStyle = ComboBoxStyle.DropDownList, Width = 155 };
+
+    private void InitializeExplorationTools(TableLayoutPanel layout)
+    {
+        var tools = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true };
+        tools.Controls.Add(new Label { Text = "Exploration unlock", AutoSize = true, Padding = new Padding(0, 5, 0, 0) });
+        _explorationValue.Items.AddRange(["false", "true", "Inherited / unspecified"]); _explorationValue.SelectedIndex = 0;
+        tools.Controls.Add(_explorationValue);
+        void Button(string text, Action action)
+        {
+            var button = new Button { Text = text, AutoSize = true };
+            button.Click += (_, _) =>
+            {
+                if (_loading || _loadedWorkspace is null || _loadedWorkspace != _getWorkspacePath().Trim()) return;
+                try { action(); } catch (Exception ex) { _status.Text = "Could not update exploration flags: " + ex.Message; }
+            };
+            tools.Controls.Add(button);
+        }
+        Button("Set selected", () =>
+        {
+            if (SelectedExploration() is not { } row) { _status.Text = "Select a resolved addon or upgrade first."; return; }
+            row.Draft = _explorationValue.SelectedIndex == 2 ? null : _explorationValue.SelectedItem!.ToString(); UpdateExplorationCells();
+        });
+        Button("Reset selected to original", () =>
+        {
+            if (SelectedExploration() is not { HasOriginal: true } row) { _status.Text = "The selected definition has no readable original exploration value."; return; }
+            row.Draft = row.Original; UpdateExplorationCells();
+        });
+        Button("Reset all exploration flags", () =>
+        {
+            foreach (var row in _explorationRows.Values.Where(r => r.HasOriginal)) row.Draft = row.Original;
+            UpdateExplorationCells();
+        });
+        Button("Stage exploration changes", () =>
+        {
+            var edits = ExplorationEdits(); AddonExplorationStore.Save(_loadedWorkspace!, edits);
+            _stagedExploration = edits.ToDictionary(e => AddonExplorationStore.Key(e.Source, e.Element, e.Variant), e => e.After, StringComparer.OrdinalIgnoreCase);
+            UpdateExplorationCells(); _status.Text = $"Staged {edits.Count} exploration changes across all addon views and filters. Apply pending changes from Start.";
+        });
+        Button("Revert unstaged exploration edits", () => { RestoreExploration(); UpdateExplorationCells(); });
+        Button("Revert staged exploration changes", () => { AddonExplorationStore.Save(_loadedWorkspace!, []); RestoreExploration(); UpdateExplorationCells(); });
+        layout.Controls.Add(tools, 0, 1);
+    }
+    private AddonExplorationRow? SelectedExploration() => _addons.CurrentRow?.DataBoundItem is DataRowView view
+        && view["Entry"] is AddonCatalogEntry entry ? _explorationRows.GetValueOrDefault(AddonExplorationStore.Key(entry)) : null;
+    private List<AddonExplorationEdit> ExplorationEdits() => _explorationRows.Values.Where(r => r.Draft != r.Current)
+        .Select(r => r.Identity with { After = r.Draft }).ToList();
+    private void RestoreExploration()
+    {
+        var edits = AddonExplorationStore.Load(_loadedWorkspace!);
+        var byKey = edits.ToDictionary(e => AddonExplorationStore.Key(e.Source, e.Element, e.Variant), StringComparer.OrdinalIgnoreCase);
+        _stagedExploration = edits.ToDictionary(e => AddonExplorationStore.Key(e.Source, e.Element, e.Variant), e => e.After, StringComparer.OrdinalIgnoreCase);
+        foreach (var (key, row) in _explorationRows) row.Draft = byKey.TryGetValue(key, out var edit) ? edit.After : row.Current;
+    }
+    private string ExplorationState(AddonCatalogEntry entry)
+    {
+        var key = AddonExplorationStore.Key(entry);
+        if (!_explorationRows.TryGetValue(key, out var row)) return "Read-only";
+        if (row.Draft != row.Current) return _stagedExploration.TryGetValue(key, out var staged) && staged == row.Draft ? "Staged" : "Draft";
+        return row.HasOriginal && row.Current != row.Original ? "In files" : "Original";
+    }
+    private void UpdateExplorationCells()
+    {
+        if (_addons.DataSource is not DataTable table) return;
+        foreach (DataRow data in table.Rows)
+            if (data["Entry"] is AddonCatalogEntry entry && _explorationRows.TryGetValue(AddonExplorationStore.Key(entry), out var row))
+            { data["Exploration unlock"] = AddonExplorationStore.Display(row.Draft); data["Change state"] = ExplorationState(entry); }
+        _addons.Invalidate(); ShowProperties();
+        _status.Text = $"{_explorationRows.Values.Count(r => r.Draft != r.Current)} exploration changes in preview. Reset all covers all addon views, including filtered rows. Stage, then Apply from Start.";
+    }
+    private void FormatExploration(object? sender, DataGridViewCellFormattingEventArgs e)
+    {
+        if (e.RowIndex < 0 || e.ColumnIndex < 0 || _addons.Columns[e.ColumnIndex].Name != "Exploration unlock"
+            || _addons.Rows[e.RowIndex].DataBoundItem is not DataRowView view || view["Entry"] is not AddonCatalogEntry entry
+            || !_explorationRows.TryGetValue(AddonExplorationStore.Key(entry), out var row)) return;
+        var current = AddonExplorationStore.Display(row.Draft);
+        e.Value = row.HasOriginal && row.Draft != row.Original ? $"{current} ({AddonExplorationStore.Display(row.Original)})" : current;
+        e.CellStyle!.BackColor = row.Draft != row.Current ? Color.LightGoldenrodYellow
+            : row.HasOriginal && row.Current != row.Original ? Color.Honeydew : AppColors.Get("Surface");
+        e.FormattingApplied = true;
+        _addons.Rows[e.RowIndex].Cells[e.ColumnIndex].ToolTipText = $"Original: {(row.HasOriginal ? AddonExplorationStore.Display(row.Original) : "Unavailable")}\nIn files: {AddonExplorationStore.Display(row.Current)}\nPreview: {current}\nInherited / unspecified removes the local attribute; parent/template rules may still apply.";
+    }
+    internal void ExportExplorationPreview(string destination)
+    {
+        if (!_frameAddonsOnly && _loadedWorkspace == _getWorkspacePath().Trim()) AddonExplorationStore.Save(destination, ExplorationEdits());
+    }
+}
