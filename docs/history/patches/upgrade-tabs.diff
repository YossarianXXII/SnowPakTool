index 0000000..e8c97e8
--- /dev/null
+++ b/src/SnowPakTool.Desktop/UpgradeRandomizationRuleStore.cs
@@ -0,0 +1,41 @@
+using System.Text.Json;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed class UpgradeRandomizationRules
+{
+    public List<string> Rules { get; set; } = [];
+}
+
+internal sealed class UpgradeRandomizationRuleStore
+{
+    private readonly string _path;
+
+    public UpgradeRandomizationRuleStore(string? path = null) => _path = path ?? Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+        "SnowPakTool.Desktop", "upgrade-randomization-rules.json");
+
+    public UpgradeRandomizationRules Load()
+    {
+        if (!File.Exists(_path)) return new();
+        var rules = JsonSerializer.Deserialize<UpgradeRandomizationRules>(File.ReadAllText(_path))
+            ?? throw new JsonException("The saved rule list is empty.");
+        Validate(rules);
+        return rules;
+    }
+
+    public void Save(UpgradeRandomizationRules rules)
+    {
+        Validate(rules);
+        Directory.CreateDirectory(Path.GetDirectoryName(Path.GetFullPath(_path))!);
+        var temporary = _path + ".tmp";
+        File.WriteAllText(temporary, JsonSerializer.Serialize(rules, new JsonSerializerOptions { WriteIndented = true }));
+        File.Move(temporary, _path, overwrite: true);
+    }
+
+    private static void Validate(UpgradeRandomizationRules rules)
+    {
+        if (rules.Rules is null || rules.Rules.Any(string.IsNullOrWhiteSpace))
+            throw new JsonException("Rules must be a list of non-empty notes.");
+    }
+}
diff --git a/src/SnowPakTool.Desktop/MapUpgradesTab.cs b/src/SnowPakTool.Desktop/MapUpgradesTab.cs
new file mode 100644
index 0000000..7593a41
--- /dev/null
+++ b/src/SnowPakTool.Desktop/MapUpgradesTab.cs
@@ -0,0 +1,190 @@
+using System.Data;
+
+namespace SnowPakTool.Desktop;
+
+// Review surface for the upgrade workflow. Placement parsing and editing will be added
+// with the upgrade plan; never route these controls through truck replacement state.
+internal sealed class MapUpgradesTab : UserControl
+{
+    private readonly Func<string> _getWorkspacePath;
+    private readonly Func<string> _getPakPath;
+    private readonly TextBox _mapFolder = new() { Dock = DockStyle.Fill, PlaceholderText = "Folder containing level_*.pak or extracted map folders" };
+    private readonly Button _browse = new() { Text = "Browse…", AutoSize = true };
+    private readonly Button _reload = new() { Text = "Reload maps", AutoSize = true };
+    private readonly FlowLayoutPanel _regions = new()
+    {
+        Dock = DockStyle.Fill, FlowDirection = FlowDirection.LeftToRight, WrapContents = false,
+        AutoScroll = true, Padding = new Padding(2), Margin = Padding.Empty
+    };
+    private readonly HashSet<string> _selectedRegions = new(StringComparer.OrdinalIgnoreCase);
+    private readonly Dictionary<string, RegionTileButton> _tiles = new(StringComparer.OrdinalIgnoreCase);
+    private readonly Label _status = new() { AutoSize = true, Dock = DockStyle.Fill, Padding = new Padding(4, 5, 4, 5) };
+    private readonly TextBox _details = new() { Dock = DockStyle.Fill, ReadOnly = true, Multiline = true, ScrollBars = ScrollBars.Both, WordWrap = false };
+    private readonly DataGridView _upgrades = new()
+    {
+        Dock = DockStyle.Fill, ReadOnly = true, AutoGenerateColumns = false, AllowUserToAddRows = false, AllowUserToDeleteRows = false,
+        AllowUserToResizeRows = false, RowHeadersVisible = false, MultiSelect = false,
+        SelectionMode = DataGridViewSelectionMode.FullRowSelect, AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None,
+        Font = new Font(SystemFonts.MessageBoxFont!.FontFamily, 9f),
+        ColumnHeadersDefaultCellStyle = { Font = new Font(SystemFonts.MessageBoxFont!.FontFamily, 9f, FontStyle.Bold) },
+        RowTemplate = { Height = 26 }
+    };
+    private readonly ToolTip _tips = new();
+    private string? _loadedWorkspace;
+    private bool _loading;
+
+    public MapUpgradesTab(Func<string> getWorkspacePath, Func<string> getPakPath)
+    {
+        _getWorkspacePath = getWorkspacePath;
+        _getPakPath = getPakPath;
+        var layout = new TableLayoutPanel { Dock = DockStyle.Fill, ColumnCount = 1, RowCount = 5, Padding = new Padding(12) };
+        layout.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
+        layout.RowStyles.Add(new RowStyle(SizeType.Absolute, 238));
+        layout.RowStyles.Add(new RowStyle(SizeType.AutoSize));
+        layout.RowStyles.Add(new RowStyle(SizeType.AutoSize));
+        layout.RowStyles.Add(new RowStyle(SizeType.AutoSize));
+        layout.RowStyles.Add(new RowStyle(SizeType.Percent, 100));
+        layout.Controls.Add(_regions, 0, 0);
+        var folderRow = new TableLayoutPanel { Dock = DockStyle.Fill, AutoSize = true, ColumnCount = 4 };
+        folderRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
+        folderRow.ColumnStyles.Add(new ColumnStyle(SizeType.Percent, 100));
+        folderRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
+        folderRow.ColumnStyles.Add(new ColumnStyle(SizeType.AutoSize));
+        folderRow.Controls.Add(new Label { Text = "Map folder", AutoSize = true, Padding = new Padding(0, 5, 8, 0) }, 0, 0);
+        folderRow.Controls.Add(_mapFolder, 1, 0);
+        folderRow.Controls.Add(_browse, 2, 0);
+        folderRow.Controls.Add(_reload, 3, 0);
+        layout.Controls.Add(folderRow, 0, 1);
+        var actions = new FlowLayoutPanel { Dock = DockStyle.Fill, AutoSize = true };
+        var all = new Button { Text = "Select all regions", AutoSize = true };
+        var clear = new Button { Text = "Clear selection", AutoSize = true };
+        actions.Controls.Add(all);
+        actions.Controls.Add(clear);
+        foreach (var text in new[] { "Reset selected to original", "Reset selected regions to original", "Reset all to original", "Stage changes" })
+        {
+            var button = new Button { Text = text, AutoSize = true, Enabled = false };
+            button.AccessibleDescription = "Available after upgrade placement reading and editing are implemented.";
+            _tips.SetToolTip(button, button.AccessibleDescription);
+            actions.Controls.Add(button);
+        }
+        layout.Controls.Add(actions, 0, 2);
+        layout.Controls.Add(_status, 0, 3);
+        var split = new SplitContainer
+        {
+            Dock = DockStyle.Fill, Orientation = Orientation.Horizontal, Size = new Size(900, 500),
+            SplitterDistance = 285, Panel1MinSize = 60, Panel2MinSize = 60, SplitterWidth = 6
+        };
+        TableHeaderBehavior.Attach(_upgrades);
+        var table = new DataTable();
+        foreach (var name in new[] { "Region", "Map", "Upgrade", "Type", "Compatible trucks", "Placement ID", "Upgrade ID", "Change state" })
+        {
+            table.Columns.Add(name);
+            _upgrades.Columns.Add(new DataGridViewTextBoxColumn
+            {
+                Name = name, HeaderText = name, DataPropertyName = name,
+                Width = name switch { "Upgrade" => 210, "Compatible trucks" => 250, _ => 160 },
+                SortMode = DataGridViewColumnSortMode.Automatic
+            });
+        }
+        _upgrades.DataSource = table;
+        split.Panel1.Controls.Add(_upgrades);
+        split.Panel2.Controls.Add(_details);
+        layout.Controls.Add(split, 0, 4);
+        Controls.Add(layout);
+        _status.Text = "Choose an extracted workspace on Start. Upgrade placement reading and editing are not implemented yet.";
+        _details.Text = "Upgrade placements and original/current comparisons will appear here when upgrade map support is implemented.";
+        all.Click += (_, _) => { _selectedRegions.UnionWith(_tiles.Keys); RefreshSelection(); };
+        clear.Click += (_, _) => { _selectedRegions.Clear(); RefreshSelection(); };
+        _reload.Click += async (_, _) => await LoadAsync(force: true);
+        _browse.Click += async (_, _) =>
+        {
+            using var dialog = new FolderBrowserDialog { Description = "Choose the folder containing level_*.pak archives or extracted map folders." };
+            if (Directory.Exists(_mapFolder.Text)) dialog.SelectedPath = _mapFolder.Text;
+            if (dialog.ShowDialog(this) != DialogResult.OK) return;
+            _mapFolder.Text = dialog.SelectedPath;
+            await LoadAsync(force: true);
+        };
+        AppColors.Changed += PaletteChanged;
+        Disposed += (_, _) => { AppColors.Changed -= PaletteChanged; _tips.Dispose(); };
+        TextAreaStyle.Mark(_details);
+    }
+
+    public Task EnsureLoadedAsync() => LoadAsync(force: false);
+
+    private async Task LoadAsync(bool force)
+    {
+        if (_loading) return;
+        var workspace = _getWorkspacePath().Trim();
+        if (_mapFolder.Text.Length == 0) _mapFolder.Text = RegionTruckCatalogService.FindMapDirectory(_getPakPath());
+        if (!force && workspace.Equals(_loadedWorkspace, StringComparison.OrdinalIgnoreCase)) return;
+        var sameWorkspace = workspace.Equals(_loadedWorkspace, StringComparison.OrdinalIgnoreCase);
+        ClearRegions();
+        if (!sameWorkspace) _selectedRegions.Clear();
+        if (!Directory.Exists(workspace))
+        {
+            _status.Text = "Choose an extracted workspace on Start. Upgrade placement reading and editing are not implemented yet.";
+            return;
+        }
+        _loading = true;
+        _browse.Enabled = _reload.Enabled = false;
+        _mapFolder.ReadOnly = true;
+        _status.Text = "Loading workspace regions…";
+        try
+        {
+            await WorkspaceDataCache.PreloadOwnedAsync(workspace);
+            if (IsDisposed || !workspace.Equals(_getWorkspacePath().Trim(), StringComparison.OrdinalIgnoreCase)) return;
+            var regions = WorkspaceDataCache.GetRegionMetadata(workspace);
+            foreach (var pair in regions.OrderBy(pair => RegionTileAssets.GetReleaseOrder(pair.Key))
+                         .ThenBy(pair => pair.Key, StringComparer.OrdinalIgnoreCase))
+            {
+                var code = pair.Key;
+                var tile = new RegionTileButton
+                {
+                    Width = 150, Height = 210, Margin = new Padding(0, 0, 1, 1), FlatStyle = FlatStyle.Flat,
+                    RegionName = pair.Value.Name, ReleaseLabel = RegionTileAssets.GetReleaseLabel(code) + " · " + code.ToUpperInvariant(),
+                    Summary = "Upgrades not loaded", Thumbnail = RegionTileAssets.GetThumbnail(code), Text = pair.Value.Name,
+                    Font = new Font(SystemFonts.MessageBoxFont!.FontFamily, 9f, FontStyle.Bold),
+                    TextAlign = ContentAlignment.MiddleCenter, UseVisualStyleBackColor = false,
+                    AccessibleName = pair.Value.Name, Tag = code
+                };
+                tile.Click += (_, _) => { if (!_selectedRegions.Add(code)) _selectedRegions.Remove(code); RefreshSelection(); };
+                _tiles.Add(code, tile);
+                _regions.Controls.Add(tile);
+            }
+            _selectedRegions.IntersectWith(_tiles.Keys);
+            _loadedWorkspace = workspace;
+            RefreshSelection();
+        }
+        catch (Exception ex) { if (!IsDisposed) _status.Text = "Could not load upgrade regions: " + ex.Message; }
+        finally
+        {
+            _loading = false;
+            if (!IsDisposed) { _browse.Enabled = _reload.Enabled = true; _mapFolder.ReadOnly = false; }
+        }
+    }
+
+    private void ClearRegions()
+    {
+        foreach (var tile in _tiles.Values) tile.Dispose();
+        _tiles.Clear();
+        _regions.Controls.Clear();
+        _loadedWorkspace = null;
+    }
+
+    private void PaletteChanged(object? sender, EventArgs e) => RefreshSelection();
+
+    private void RefreshSelection()
+    {
+        foreach (var (code, tile) in _tiles)
+        {
+            var selected = _selectedRegions.Contains(code);
+            tile.BackColor = selected ? AppColors.Get("SelectionBlue") : Color.FromArgb(32, 38, 45);
+            tile.ForeColor = tile.BackColor.GetBrightness() < 0.55f ? Color.White : Color.Black;
+            tile.FlatAppearance.BorderSize = selected ? 3 : 1;
+            tile.FlatAppearance.BorderColor = selected ? SystemColors.Highlight : Color.FromArgb(70, 80, 90);
+            tile.AccessibleDescription = selected ? "Selected region. Activate to deselect." : "Activate to select this region.";
+        }
+        if (_loadedWorkspace is not null)
+            _status.Text = $"{_selectedRegions.Count} of {_tiles.Count} workspace regions selected. Upgrade placement reading and editing are not implemented yet.";
+    }
+}
