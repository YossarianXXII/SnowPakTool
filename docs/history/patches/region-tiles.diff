diff --git a/src/SnowPakTool.Desktop/RegionTileAssets.cs b/src/SnowPakTool.Desktop/RegionTileAssets.cs
new file mode 100644
index 0000000..f89dcd7
--- /dev/null
+++ b/src/SnowPakTool.Desktop/RegionTileAssets.cs
@@ -0,0 +1,37 @@
+using System.Collections.Concurrent;
+
+namespace SnowPakTool.Desktop;
+
+internal static class RegionTileAssets
+{
+    // Base-game regions, then the regions introduced in seasons 1–19.
+    // Region IDs match dlc_library.sso; chronology follows the original releases,
+    // including seasons 1–3 that predate SnowRunner's Steam launch.
+    private static readonly string[] ReleaseOrder =
+    [
+        "us_01", "us_02", "ru_02", "ru_03", "us_04", "us_03", "ru_04", "ru_05",
+        "us_06", "us_07", "ru_08", "us_09", "us_10", "us_11", "us_12", "ru_13",
+        "us_14", "us_15", "us_16", "ru_17", "us_18", "us_19"
+    ];
+    private static readonly ConcurrentDictionary<string, Lazy<Image?>> Images = new(StringComparer.OrdinalIgnoreCase);
+
+    public static int GetReleaseOrder(string code)
+    {
+        var index = Array.FindIndex(ReleaseOrder, item => item.Equals(code, StringComparison.OrdinalIgnoreCase));
+        return index < 0 ? int.MaxValue : index;
+    }
+
+    public static string GetReleaseLabel(string code)
+    {
+        var order = GetReleaseOrder(code);
+        return order == int.MaxValue ? "Region" : order < 3 ? "Base game" : $"Season {order - 2}";
+    }
+
+    public static Image? GetThumbnail(string code) => Images.GetOrAdd(code, key => new Lazy<Image?>(() =>
+    {
+        using var stream = typeof(RegionTileAssets).Assembly.GetManifestResourceStream($"SnowPakTool.Desktop.Assets.Regions.{key.ToLowerInvariant()}.png");
+        if (stream is null) return null;
+        using var source = Image.FromStream(stream);
+        return new Bitmap(source);
+    })).Value;
+}
diff --git a/src/SnowPakTool.Desktop/RegionTileButton.cs b/src/SnowPakTool.Desktop/RegionTileButton.cs
new file mode 100644
index 0000000..799b2e2
--- /dev/null
+++ b/src/SnowPakTool.Desktop/RegionTileButton.cs
@@ -0,0 +1,58 @@
+using System.ComponentModel;
+
+namespace SnowPakTool.Desktop;
+
+/// <summary>A keyboard-selectable region card using the same dimensions and header style as truck tiles.</summary>
+internal sealed class RegionTileButton : Button
+{
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    internal string RegionName { get; init; } = "";
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    internal string ReleaseLabel { get; init; } = "";
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    internal string Summary { get; init; } = "";
+    // Cached by RegionTileAssets and shared by every tile for this region.
+    [DesignerSerializationVisibility(DesignerSerializationVisibility.Hidden)]
+    internal Image? Thumbnail { get; init; }
+
+    public RegionTileButton()
+    {
+        SetStyle(ControlStyles.UserPaint | ControlStyles.AllPaintingInWmPaint | ControlStyles.OptimizedDoubleBuffer, true);
+    }
+
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        var graphics = e.Graphics;
+        graphics.Clear(BackColor);
+        var border = Math.Max(1, FlatAppearance.BorderSize);
+        var inner = new Rectangle(border, border, Math.Max(1, Width - 2 * border), Math.Max(1, Height - 2 * border));
+        var header = new Rectangle(inner.X, inner.Y, inner.Width, 30);
+        using var headerFont = new Font(SystemFonts.MessageBoxFont!.FontFamily, 8.5f, FontStyle.Bold);
+        TextRenderer.DrawText(graphics, RegionName, headerFont, header, ForeColor,
+            TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak | TextFormatFlags.EndEllipsis);
+
+        var picture = new Rectangle(inner.X, header.Bottom, inner.Width, Math.Max(1, inner.Height - 30 - 76));
+        using (var background = new SolidBrush(Color.FromArgb(30, 35, 40))) graphics.FillRectangle(background, picture);
+        if (Thumbnail is not null)
+        {
+            var scale = Math.Min((float)picture.Width / Thumbnail.Width, (float)picture.Height / Thumbnail.Height);
+            var width = Math.Max(1, (int)Math.Round(Thumbnail.Width * scale));
+            var height = Math.Max(1, (int)Math.Round(Thumbnail.Height * scale));
+            var destination = new Rectangle(picture.X + (picture.Width - width) / 2, picture.Y + (picture.Height - height) / 2, width, height);
+            graphics.InterpolationMode = System.Drawing.Drawing2D.InterpolationMode.HighQualityBicubic;
+            graphics.DrawImage(Thumbnail, destination);
+        }
+
+        var release = new Rectangle(inner.X + 2, picture.Bottom + 2, inner.Width - 4, 15);
+        using var releaseFont = new Font(SystemFonts.MessageBoxFont!.FontFamily, 7.5f, FontStyle.Bold);
+        TextRenderer.DrawText(graphics, ReleaseLabel, releaseFont, release, ForeColor,
+            TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.EndEllipsis);
+        var summary = new Rectangle(inner.X + 2, release.Bottom, inner.Width - 4, inner.Bottom - release.Bottom);
+        using var summaryFont = new Font(SystemFonts.MessageBoxFont!.FontFamily, 8f);
+        TextRenderer.DrawText(graphics, Summary, summaryFont, summary, ForeColor,
+            TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.WordBreak);
+        using var pen = new Pen(FlatAppearance.BorderColor, border);
+        graphics.DrawRectangle(pen, border / 2f, border / 2f, Width - border, Height - border);
+        if (Focused) ControlPaint.DrawFocusRectangle(graphics, Rectangle.Inflate(ClientRectangle, -border - 2, -border - 2), ForeColor, BackColor);
+    }
+}
