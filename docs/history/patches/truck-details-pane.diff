@@ -0,0 +1,54 @@
+using System.Globalization;
+using System.Text;
+
+namespace SnowPakTool.Desktop;
+
+internal static class TruckDetailsFormatter
+{
+    public static string Format(RegionTruckEntry entry)
+    {
+        var text = new StringBuilder();
+        text.AppendLine(entry.Truck + " — " + entry.Map);
+        text.AppendLine();
+        text.AppendLine("PLACEMENT");
+        text.AppendLine("Model ID: " + entry.TruckCode);
+        text.AppendLine("Placement ID: " + (entry.PlacementId.Length == 0 ? "None (unnamed map placement)" : entry.PlacementId));
+        text.AppendLine("Map ID: " + entry.MapCode);
+        text.AppendLine("Position (X; Y; Z): " + string.Join("; ", new[] { entry.X, entry.Y, entry.Z }
+            .Select(value => value.ToString("0.###", CultureInfo.InvariantCulture))));
+        if (entry.BinaryOffset >= 0) text.AppendLine($"Map record offset: 0x{entry.BinaryOffset:X} (offset may change after editing)");
+        text.AppendLine("Source: " + entry.Source);
+        if (entry.Transform is { Count: 16 } matrix)
+        {
+            text.AppendLine("World transform (orientation and position, 4 × 4):");
+            for (var row = 0; row < 4; row++)
+                text.AppendLine("  " + string.Join("  ", matrix.Skip(row * 4).Take(4).Select(value => value.ToString("0.######", CultureInfo.InvariantCulture))));
+        }
+        Section("AVAILABILITY EVIDENCE", entry.Evidence);
+        text.AppendLine(); text.AppendLine("INTERNAL EQUIPMENT / DRIVETRAIN");
+        if (entry.InternalEquipment is not { Count: > 0 }) text.AppendLine("Internal equipment could not be resolved from this placement.");
+        else foreach (var item in entry.InternalEquipment)
+        {
+            text.AppendLine($"{item.Slot}: {item.Name}" + (item.Id.Length > 0 ? $" ({item.Id})" : "") + $" [{item.Origin}]");
+            if (item.SourcePath.Length > 0) text.AppendLine("  Source: " + item.SourcePath);
+            if (item.DefinitionDetails.Length > 0) text.AppendLine("  " + item.DefinitionDetails.Replace("\r\n", "\r\n  "));
+            text.AppendLine();
+        }
+        text.AppendLine("VISUAL ADDONS (_tuning folders)");
+        var visual = (entry.InstalledAddons ?? []).Where(addon => addon.IsVisual).ToArray();
+        if (entry.InstalledAddons is null) text.AppendLine("Installed addon data could not be read.");
+        else if (visual.Length == 0) text.AppendLine("None.");
+        else foreach (var addon in visual)
+        {
+            text.AppendLine($"• {addon.Name} ({addon.Id}) [{addon.Origin}; category: {addon.Category}]");
+            text.AppendLine("  Source: " + addon.SourcePath);
+        }
+        Section("TIRE / WHEEL DETAILS", entry.TireDetails);
+        Section("FRAME ADDON DETAILS", entry.FrameAddonDetails);
+        Section("OTHER ADDON DETAILS", entry.AddonDetails);
+        return text.ToString().TrimEnd();
+
+        void Section(string title, string body)
+        { text.AppendLine(); text.AppendLine(title); text.AppendLine(body.Length == 0 ? "Not available." : body); }
+    }
+}
