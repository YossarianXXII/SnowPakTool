+    {
+        foreach (var role in new[] { "Loose", "Packed" })
+        {
+            var index = 0;
+            foreach (var target in entry.MassTargets.Where(target => target.Role == role)) yield return (RawColumn(role, index++), target);
+        }
+    }
+    private void AddRawMassColumns(DataTable table)
+    {
+        foreach (var role in new[] { "Loose", "Packed" })
+            for (var index = 0; index < (_catalog?.Entries.Select(entry => entry.MassTargets.Count(target => target.Role == role)).DefaultIfEmpty().Max() ?? 0); index++)
+                table.Columns.Add(RawColumn(role, index), typeof(decimal));
+    }
+    private CargoMassRow? CellMassRow(int row, int column)
+    {
+        if (row < 0 || column < 0 || _cargo.Rows[row].DataBoundItem is not DataRowView data || data["Entry"] is not CargoEntry entry) return null;
+        var target = RawTargets(entry).FirstOrDefault(pair => pair.Column == _cargo.Columns[column].Name).Target;
+        return target is null ? null : _massRows.GetValueOrDefault(CargoMassStore.Key(target));
+    }
+    private static bool TryMass(object? input, out string? value)
+    {
+        var text = input is null or DBNull ? "" : Convert.ToString(input, CultureInfo.CurrentCulture)?.Trim() ?? "";
+        value = null;
+        if (text.Length == 0) return true;
+        if (!decimal.TryParse(text, NumberStyles.Number, CultureInfo.CurrentCulture, out var number) || number < 0 || number > 1000000) return false;
+        value = number.ToString(CultureInfo.InvariantCulture); return true;
+    }
+    private bool CommitMass()
+    {
+        if (_cargo.IsCurrentCellInEditMode && _cargo.EditingControl is TextBox text && !TryMass(text.Text, out _))
+        { _status.Text = "Enter a mass from 0 to 1,000,000 kg, or leave blank to restore inheritance."; return false; }
+        if (!_cargo.EndEdit()) return false;
+        if (_cargo.DataSource is DataTable table) BindingContext?[table]?.EndCurrentEdit();
+        return true;
+    }
+    private void InitializeMassEditing(FlowLayoutPanel toolbar)
+    {
+        void Button(string text, Action action)
+        {
+            var button = new Button { Text = text, AutoSize = true };
+            button.Click += (_, _) =>
+            {
+                if (_loadedWorkspace is null || _loadedWorkspace != _getWorkspacePath().Trim() || PresetBrowseMode.IsReadOnly(this) || !CommitMass()) return;
+                try { action(); }
+                catch (Exception ex) { _status.Text = "Could not update cargo masses: " + ex.Message; }
+            };
+            toolbar.Controls.Add(button);
+        }
+        Button("Stage changes", () =>
+        {
+            var edits = MassEdits();
+            CargoMassStore.Save(_loadedWorkspace!, edits); RestoreStagedMass(); UpdateMassCells(); StagingChanged?.Invoke();
+            _status.Text = $"Staged {edits.Count} raw cargo mass changes. Apply pending changes from Start.";
+        });
+        Button("Revert unstaged edits", () => { RestoreStagedMass(); UpdateMassCells(); });
+        Button("Revert staged changes", () => { CargoMassStore.Save(_loadedWorkspace!, []); RestoreStagedMass(); UpdateMassCells(); StagingChanged?.Invoke(); });
+        Button("Reset selected to original", () =>
+        {
+            if (_cargo.CurrentRow?.DataBoundItem is DataRowView data && data["Entry"] is CargoEntry entry)
+                foreach (var target in entry.MassTargets)
+                    if (_massRows.TryGetValue(CargoMassStore.Key(target), out var row) && row.HasOriginal) row.Draft = row.Original;
+            UpdateMassCells();
+        });
+        Button("Reset to original values", () => { foreach (var row in _massRows.Values.Where(row => row.HasOriginal)) row.Draft = row.Original; UpdateMassCells(); });
+        _cargo.CellBeginEdit += (_, e) => { if (PresetBrowseMode.IsReadOnly(this) || CellMassRow(e.RowIndex, e.ColumnIndex) is null) e.Cancel = true; };
+        _cargo.CellValidating += (_, e) =>
+        {
+            if (CellMassRow(e.RowIndex, e.ColumnIndex) is null) return;
+            if (!TryMass(e.FormattedValue, out var parsed)) { e.Cancel = true; _status.Text = "Enter a mass from 0 to 1,000,000 kg, or blank for inheritance."; }
+        };
+        _cargo.CellParsing += (_, e) =>
+        {
+            if (CellMassRow(e.RowIndex, e.ColumnIndex) is null || !TryMass(e.Value, out var value)) return;
+            e.Value = value is null ? DBNull.Value : decimal.Parse(value, CultureInfo.InvariantCulture); e.ParsingApplied = true;
+        };
+        _cargo.CellValueChanged += (_, e) =>
+        {
+            if (_bindingMass || CellMassRow(e.RowIndex, e.ColumnIndex) is not { } row || !TryMass(_cargo[e.ColumnIndex, e.RowIndex].Value, out var value)) return;
+            row.Draft = value; UpdateMassCells();
+        };
+        _cargo.EditingControlShowing += (_, e) =>
+        {
+            if (_cargo.CurrentCell is not { } cell || CellMassRow(cell.RowIndex, cell.ColumnIndex) is not { } row || e.Control is not TextBox text) return;
+            text.Text = row.Draft is null ? "" : decimal.Parse(row.Draft, CultureInfo.InvariantCulture).ToString(CultureInfo.CurrentCulture); text.SelectAll();
+        };
+        _cargo.CellFormatting += FormatMass;
+        _cargo.DataError += (_, e) => { e.ThrowException = false; _status.Text = "Enter a valid mass in kg."; };
+    }
+    private List<CargoMassEdit> MassEdits() => _massRows.Values.Where(row => !CargoMassStore.Equal(row.Draft, row.Current))
+        .Select(row => new CargoMassEdit(row.Target.RelativeFile, row.Target.BodyPath, row.Target.ModelFrame, row.Structure,
+            row.Target.Role + " cargo mass", row.Current, row.Draft)).ToList();
+    private void RestoreStagedMass()
+    {
+        _stagedMass = CargoMassStore.Load(_loadedWorkspace!).ToDictionary(edit => CargoMassStore.Key(edit.RelativeFile, edit.BodyPath), StringComparer.OrdinalIgnoreCase);
+        foreach (var (key, row) in _massRows)
+            row.Draft = _stagedMass.TryGetValue(key, out var edit) ? edit.After : row.Current;
+    }
+    private decimal? PreviewTotal(CargoEntry entry, string role)
+    {
+        var groups = entry.MassTargets.Where(target => target.Role == role).GroupBy(target => target.RelativeFile).ToArray();
+        var totals = new List<decimal>();
+        foreach (var group in groups)
+        {
+            decimal total = 0;
+            foreach (var target in group)
+            {
+                var row = _massRows[CargoMassStore.Key(target)];
+                if (row.Draft is not null) total += decimal.Parse(row.Draft, CultureInfo.InvariantCulture);
+                else if (target.InheritedMass.HasValue) total += target.InheritedMass.Value;
+                else return null;
+            }
+            totals.Add(total);
+        }
+        return totals.Count > 0 && totals.Distinct().Count() == 1 ? totals[0] : null;
+    }
+    private void UpdateMassCells()
+    {
+        if (_cargo.DataSource is not DataTable table) return;
+        _bindingMass = true;
+        try
+        {
+            foreach (DataRow data in table.Rows)
+            {
+                if (data["Entry"] is not CargoEntry entry) continue;
+                foreach (var (column, target) in RawTargets(entry))
+                {
+                    var row = _massRows[CargoMassStore.Key(target)];
+                    data[column] = row.Draft is null ? DBNull.Value : decimal.Parse(row.Draft, CultureInfo.InvariantCulture);
+                }
+                data["Loose weight (kg)"] = (object?)PreviewTotal(entry, "Loose") ?? DBNull.Value;
+                data["Packed weight (kg)"] = (object?)PreviewTotal(entry, "Packed") ?? DBNull.Value;
+            }
+            foreach (DataGridViewRow gridRow in _cargo.Rows)
+                foreach (DataGridViewColumn column in _cargo.Columns)
+                    if (IsRawMassColumn(column.Name)) gridRow.Cells[column.Index].ReadOnly = CellMassRow(gridRow.Index, column.Index) is null;
+        }
+        finally { _bindingMass = false; }
+        _cargo.Invalidate(); ShowProperties();
+    }
+    private void FormatMass(object? sender, DataGridViewCellFormattingEventArgs e)
+    {
+        if (CellMassRow(e.RowIndex, e.ColumnIndex) is not { } row) return;
+        string Display(string? value) => value is null ? "Inherited" : decimal.Parse(value, CultureInfo.InvariantCulture).ToString("0.############################", CultureInfo.CurrentCulture);
+        var key = CargoMassStore.Key(row.Target);
+        var changed = !CargoMassStore.Equal(row.Draft, row.Current);
+        var staged = _stagedMass.TryGetValue(key, out var edit) && CargoMassStore.Equal(edit.After, row.Draft);
+        e.CellStyle!.BackColor = changed ? Color.LightGoldenrodYellow
+            : row.HasOriginal && !CargoMassStore.Equal(row.Current, row.Original) ? Color.Honeydew : AppColors.Get("Surface");
+        if (!_cargo[e.ColumnIndex, e.RowIndex].IsInEditMode)
+        {
+            e.Value = row.Draft is null ? "" : Display(row.Draft);
+            if (row.HasOriginal && !CargoMassStore.Equal(row.Draft, row.Original)) e.Value = $"{Display(row.Draft)} ({Display(row.Original)})";
+            e.FormattingApplied = true;
+        }
+        _cargo[e.ColumnIndex, e.RowIndex].ToolTipText = $"{row.Target.RelativeFile}\n{row.Target.BodyPath}/@Mass\nModelFrame: {row.Target.ModelFrame}\nOriginal raw: {(row.HasOriginal ? Display(row.Original) : "Unavailable")}\nIn files: {Display(row.Current)}\nPreview: {Display(row.Draft)}\nState: {(changed ? staged ? "Staged" : "Draft" : "In files")}\nBlank removes this local Mass attribute. Other rows sharing this file/body change together.";
+    }
+    internal void InvalidateCatalog() { _loadedWorkspace = null; }
+    internal void ExportPreview(string destination)
+    {
+        if (_loadedWorkspace != _getWorkspacePath().Trim()) return;
+        if (!CommitMass()) throw new InvalidDataException("Finish editing cargo masses before sharing.");
+        CargoMassStore.Save(destination, MassEdits());
+    }
+    internal IEnumerable<WorkspaceChange> PresetPreviewChanges() => _loadedWorkspace is null || _loadedWorkspace != _getWorkspacePath().Trim() ? [] : MassEdits().Select(edit =>
+        new WorkspaceChange(WorkspaceChange.Pending, WorkspaceOriginals.GetCurrentPath(_loadedWorkspace, edit.RelativeFile),
+            edit.Name + " / " + edit.BodyPath + "/@Mass", edit.Before ?? "Not present", edit.After ?? "Not present"));
+}
diff --git a/SnowRunnerTools-master/src/SnowPakTool.Desktop/CargoMassStore.cs b/SnowRunnerTools-master/src/SnowPakTool.Desktop/CargoMassStore.cs
