+        }))!;
+        Static("TruckPropertiesStore", "SaveSnapshot", root, Property(countryOnly, "Values"), Property(countryOnly, "Countries"));
+        Check(Items(Call(tab, "PendingChanges", root)!).Count() == 1, "country-only edits are visible on Start without numeric edits");
+        Static("TruckPropertiesStore", "Apply", root);
+        Wait((Task)Call(tab, "EnsureLoadedAsync", true)!);
+        All(tab).OfType<Button>().Single(button => button.Text == "Reset to original values").PerformClick(); Call(tab, "Stage"); Call(tab, "SavePendingChanges");
+        var restored = Static("TruckPropertiesStore", "LoadRows", root)!;
+        Check(Items(restored).All(row => (string)Property(row, "Country") == (string)Property(row, "OriginalCountry")
+            && Draft(row)["UnlockByRank"] == (Code(row) == "unranked" ? 17 : 20)), "reset/stage/apply restores original ranks and store countries together");
+        if (args.Length > 0)
+        {
+            var real = Static("TruckPropertiesStore", "LoadRows", args[0])!;
+            var realOwned = Items(real).Where(row => ((string)Property(row, "RelativeFile")).StartsWith("[media]/classes/trucks/", StringComparison.OrdinalIgnoreCase) || Code(row) == "ank_mk38_ht").Select(Code).ToHashSet(StringComparer.OrdinalIgnoreCase);
+            var realPlan = Plan(real, tiers, realOwned, "Hard", 42); Coverage(real, realPlan, realOwned);
+            Check(true, "real workspace supports all country/class starters using only base-game/free-update trucks");
+        }
+        Console.WriteLine("All unlock progression, coverage, UI, staging and preset checks passed.");
+    }
+}
