diff --git a/README.md b/README.md
index 44ba921..4a90f79 100644
--- a/README.md
+++ b/README.md
@@ -24,6 +24,8 @@ All desktop tabs share one double-Shift text search with a three-character minim
 
 **Editors → Truck properties** lists truck names, classes, assigned tiers, fuel capacity, unlock rank, price, store countries, differential lock and verified obtainable regions/maps. Region information reuses Regions-Trucks, including randomized replacements and pending map changes; unavailable map data and unverified placements are not guessed. Click column headers to sort, or **Order by tier** for SS through FX followed by Unsorted. Hover a truck name to show its usual tile. Edit numeric cells individually. The compact fuel multiplier slider selects 0.5× through 3× in 0.5 steps; **Multiply all fuel** multiplies the currently displayed, explicitly defined fuel capacities, rounds to whole litres (halves away from zero), and bounds the results to the allowed range. Moving the slider alone does not change values, and repeated button clicks multiply again. Changed numeric cells show the preserved original in parentheses, e.g. **160 (80)**, with amber preview/staged and green applied highlights; editing and sorting use the numeric value. The **Columns** checkbox dropdown controls visible columns; Differential Lock is hidden and unchecked by default. Blank/inherited values stay unchanged. **Save preset / Load preset** exports/imports a versioned JSON snapshot; loading only previews matching workspace values. **Stage changes** persists an explicit snapshot across restarts and lists it on Start even before opening this tab. **Revert unstaged edits** restores that snapshot, **Revert staged changes** clears it, and **Reset to original values** previews the preserved baseline. Only Start → Apply pending PAK edits writes the updated workspace files, preserving unrelated XML and the original files; later unstaged edits are excluded. Reload properties discards unstaged edits. Staged values changed externally are rejected during Apply and can be reloaded and restaged.
 
+**Generate unlock ranks** in Truck properties previews a new unlock-rank plan from the saved truck tier list (FX/D early through S/SS late). Separate Easy / Normal / Hard radio buttons save per workspace and target soft caps of about ranks 15 / 20 / 25. Easy has the broadest, early-biased within-tier variation so stronger trucks can unlock sooner; Normal has moderate variation; Hard is later and tighter. Soft caps are not limits: individual trucks can unlock above them, up to rank 30. Unranked trucks retain their current preview ranks unless needed as a starter. Every original game class (Highway, Heavy Duty, Offroad, Heavy, Scout) must have an owned, directly purchasable rank-1 truck in every store country found in the workspace; app-only Logging/Farming Tractor classes are ignored for this check. The lowest-rated eligible candidates are preferred, with price breaking ties. Discovery/task-locked trucks and unowned DLC cannot satisfy starter coverage. If a country has no eligible candidate of a class, the generator adds that country to a suitable owned starter; if an entire game class has no eligible starter, generation stops before changing the preview and explains the missing class. Country changes are highlighted with their originals, included in pending changes, and handled together with ranks by Stage, Apply, revert and version-2 presets. Earlier numeric-only pending files and version-1 presets remain readable. Selecting difficulty and generating do not edit game files or stage the preview.
+
 The **Planning** tab contains **Truck tiers** and **Region difficulty**, alongside ownership and truck groups. **Region difficulty** ranks all regions found in the workspace in fixed S, A, B, C, and D tiers, from hardest to easiest: S red, A orange, B yellow, C green, and D blue. The same colors appear on Region progression tiles; truck tier colors are independent. It shares truck tier-list drag-and-drop, reordering, directional scrolling, palette colors, and search, with offline region thumbnails and season labels. Region rankings save automatically in their own file, independently of truck rankings.
 
 ANK MK38 Civilian (`ank_mk38_ht`) is included in the base truck catalog even though its XML is stored under `_dlc/dlc_6` without a truck entitlement entry. It appears in Planning → Truck tiers → Unsorted until ranked, and shares that assignment with Truck properties. Its tier is independent of the regular ANK MK38.
diff --git a/src/SnowPakTool.Desktop/TruckUnlockRankGenerator.cs b/src/SnowPakTool.Desktop/TruckUnlockRankGenerator.cs
new file mode 100644
index 0000000..18f9a1b
--- /dev/null
+++ b/src/SnowPakTool.Desktop/TruckUnlockRankGenerator.cs
@@ -0,0 +1,96 @@
+using System.Text.Json;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed record TruckUnlockChoice(string RelativeFile, int Rank, string Countries, bool Starter);
+internal sealed record TruckUnlockPlan(List<TruckUnlockChoice> Choices, int SoftCap, int Unranked, int CountryExtensions);
+
+internal static class TruckUnlockRankGenerator
+{
+    internal static readonly string[] GameClasses = ["HIGHWAY", "HEAVY_DUTY", "OFFROAD", "HEAVY", "SCOUT"];
+    internal static int Quality(string tier) => tier switch { "FX" => 0, "D" => 1, "C" => 2, "B" => 3, "A" => 4, "S" => 5, "SS" => 6, _ => -1 };
+    internal static int SoftCap(ProgressionDifficulty difficulty) => difficulty switch
+    {
+        ProgressionDifficulty.Easy => 15, ProgressionDifficulty.Normal => 20, ProgressionDifficulty.Hard => 25,
+        _ => throw new ArgumentOutOfRangeException(nameof(difficulty))
+    };
+    internal static string[] Countries(string value) => value.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
+        .Select(code => code.ToUpperInvariant()).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
+
+    internal static TruckUnlockPlan Generate(IReadOnlyList<TruckPropertyRow> rows, IReadOnlyList<GroupState> tiers,
+        IReadOnlySet<string> enabledCodes, ProgressionDifficulty difficulty, int seed)
+    {
+        var cap = SoftCap(difficulty);
+        var qualities = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
+        foreach (var tier in tiers)
+            foreach (var code in tier.TruckCodes)
+                if (Quality(tier.Name) is var quality && quality >= 0) qualities.TryAdd(code, quality);
+        var candidates = rows.Where(row => enabledCodes.Contains(row.Truck.Code) && row.Current.ContainsKey("UnlockByRank")
+            && row.Current.ContainsKey("Price") && !row.RequiresExploration && row.UnlockObjective.Length == 0 && !row.Locked
+            && row.Country.Length > 0 && GameClasses.Contains(row.GameClass.ToUpperInvariant())).ToArray();
+        // Check the whole guarantee before changing any preview values.
+        foreach (var gameClass in GameClasses)
+            if (!candidates.Any(row => row.GameClass.Equals(gameClass, StringComparison.OrdinalIgnoreCase)))
+                throw new InvalidOperationException($"Cannot guarantee rank-1 store coverage for {gameClass}: no owned, directly purchasable truck with explicit rank/country values is available. Discovery/task locks are preserved.");
+        var countries = rows.SelectMany(row => Countries(row.DraftCountry)).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
+        if (countries.Length == 0) throw new InvalidOperationException("No store countries were found in the truck definitions.");
+        var random = new Random(seed);
+        var ranks = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
+        var availableCountries = rows.ToDictionary(row => row.RelativeFile, row => Countries(row.DraftCountry).ToList(), StringComparer.OrdinalIgnoreCase);
+        var unranked = 0;
+        foreach (var row in rows.OrderBy(row => row.RelativeFile, StringComparer.OrdinalIgnoreCase))
+        {
+            if (!row.Draft.TryGetValue("UnlockByRank", out var current)) continue;
+            if (!qualities.TryGetValue(row.Truck.Code, out var quality)) { ranks[row.RelativeFile] = (int)current; unranked++; continue; }
+            var fraction = quality / 6.0;
+            var exponent = difficulty switch { ProgressionDifficulty.Easy => 1.15, ProgressionDifficulty.Hard => 0.85, _ => 1.0 };
+            var spread = difficulty switch { ProgressionDifficulty.Easy => 5.0, ProgressionDifficulty.Hard => 1.5, _ => 3.0 };
+            var target = 1 + (cap - 1) * Math.Pow(fraction, exponent);
+            var variation = (random.NextDouble() + random.NextDouble() + random.NextDouble() - 1.5) * spread * (0.5 + fraction * 0.5);
+            // Easy's broad spread chiefly rewards early access, with a smaller late tail around its soft cap.
+            if (difficulty == ProgressionDifficulty.Easy && variation > 0) variation *= 0.5;
+            ranks[row.RelativeFile] = Math.Clamp((int)Math.Round(target + variation, MidpointRounding.AwayFromZero), 1, 30);
+        }
+        var starters = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var extended = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+        var extensions = 0;
+        foreach (var gameClass in GameClasses)
+        {
+            var pool = candidates.Where(row => row.GameClass.Equals(gameClass, StringComparison.OrdinalIgnoreCase))
+                .OrderBy(row => qualities.GetValueOrDefault(row.Truck.Code, int.MaxValue))
+                .ThenBy(row => row.Draft.GetValueOrDefault("Price", decimal.MaxValue))
+                .ThenBy(row => row.Truck.Code, StringComparer.OrdinalIgnoreCase).ToArray();
+            foreach (var country in countries)
+            {
+                if (pool.Any(row => ranks[row.RelativeFile] == 1 && availableCountries[row.RelativeFile].Contains(country, StringComparer.OrdinalIgnoreCase))) continue;
+                var starter = pool.FirstOrDefault(row => availableCountries[row.RelativeFile].Contains(country, StringComparer.OrdinalIgnoreCase)) ?? pool[0];
+                ranks[starter.RelativeFile] = 1; starters.Add(starter.RelativeFile);
+                if (!availableCountries[starter.RelativeFile].Contains(country, StringComparer.OrdinalIgnoreCase))
+                {
+                    availableCountries[starter.RelativeFile].Add(country); extended.Add(starter.RelativeFile); extensions++;
+                }
+            }
+        }
+        return new(rows.Where(row => ranks.ContainsKey(row.RelativeFile)).Select(row => new TruckUnlockChoice(row.RelativeFile,
+            ranks[row.RelativeFile], extended.Contains(row.RelativeFile) ? string.Join(",", availableCountries[row.RelativeFile]) : row.DraftCountry,
+            starters.Contains(row.RelativeFile))).ToList(), cap, unranked, extensions);
+    }
+}
+
+internal static class TruckUnlockRankSettings
+{
+    private static string PathFor(string workspace) => WorkspaceOriginals.GetMetadataPath(workspace, "truck-properties", "unlock-rank-settings.json");
+    internal static ProgressionDifficulty Load(string workspace)
+    {
+        var path = PathFor(workspace);
+        if (!File.Exists(path)) return ProgressionDifficulty.Normal;
+        var value = JsonSerializer.Deserialize<ProgressionDifficulty>(File.ReadAllText(path));
+        if (!Enum.IsDefined(value)) throw new InvalidDataException("Invalid unlock-rank difficulty setting.");
+        return value;
+    }
+    internal static void Save(string workspace, ProgressionDifficulty value)
+    {
+        if (!Enum.IsDefined(value)) throw new ArgumentOutOfRangeException(nameof(value));
+        TruckPropertiesStore.WriteAtomic(PathFor(workspace), JsonSerializer.Serialize(value));
+    }
+}
