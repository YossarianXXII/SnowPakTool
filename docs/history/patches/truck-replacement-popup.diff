@@ -0,0 +1,44 @@
+using System.Windows.Forms.VisualStyles;
+
+namespace SnowPakTool.Desktop;
+
+/// <summary>A truck name with a separate replacement action at the right edge.</summary>
+internal sealed class TruckReplacementCell : DataGridViewTextBoxCell
+{
+    public Action<int>? Open { get; set; }
+    public override object Clone()
+    {
+        var clone = (TruckReplacementCell)base.Clone();
+        clone.Open = Open;
+        return clone;
+    }
+    private static Rectangle ButtonBounds(Rectangle cell) => new(cell.Right - 29, cell.Top + 2, 26, Math.Max(18, cell.Height - 4));
+
+    protected override void Paint(Graphics graphics, Rectangle clipBounds, Rectangle cellBounds, int rowIndex,
+        DataGridViewElementStates cellState, object? value, object? formattedValue, string? errorText,
+        DataGridViewCellStyle cellStyle, DataGridViewAdvancedBorderStyle advancedBorderStyle, DataGridViewPaintParts paintParts)
+    {
+        var style = cellStyle.Clone();
+        style.Padding = new Padding(style.Padding.Left, style.Padding.Top, style.Padding.Right + 30, style.Padding.Bottom);
+        base.Paint(graphics, clipBounds, cellBounds, rowIndex, cellState, value, formattedValue, errorText, style, advancedBorderStyle, paintParts);
+        if (rowIndex < 0 || !paintParts.HasFlag(DataGridViewPaintParts.ContentForeground)) return;
+        var button = ButtonBounds(cellBounds);
+        var state = DataGridView?.Enabled == false ? PushButtonState.Disabled : PushButtonState.Normal;
+        ButtonRenderer.DrawButton(graphics, button, state);
+        TextRenderer.DrawText(graphics, "⇄", cellStyle.Font, button, SystemColors.ControlText,
+            TextFormatFlags.HorizontalCenter | TextFormatFlags.VerticalCenter | TextFormatFlags.NoPadding);
+    }
+
+    protected override void OnMouseClick(DataGridViewCellMouseEventArgs e)
+    {
+        base.OnMouseClick(e);
+        if (e.Button == MouseButtons.Left && e.RowIndex >= 0 && ButtonBounds(new Rectangle(Point.Empty, Size)).Contains(e.Location)) Open?.Invoke(e.RowIndex);
+    }
+
+    protected override void OnKeyDown(KeyEventArgs e, int rowIndex)
+    {
+        if (e.KeyCode == Keys.F4 || (e.Alt && e.KeyCode == Keys.Down))
+        { e.Handled = e.SuppressKeyPress = true; Open?.Invoke(rowIndex); }
+        else base.OnKeyDown(e, rowIndex);
+    }
+}
diff --git a/src/SnowPakTool.Desktop/TruckReplacementDialog.cs b/src/SnowPakTool.Desktop/TruckReplacementDialog.cs
new file mode 100644
index 0000000..1f3a610
--- /dev/null
+++ b/src/SnowPakTool.Desktop/TruckReplacementDialog.cs
@@ -0,0 +1,172 @@
+using System.Data;
+using System.Text.RegularExpressions;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed record ReplacementTruck(CustomTruck Truck, TruckEquipmentSummary Equipment, IReadOnlyDictionary<string, string> Properties);
+internal sealed record TruckComparisonRow(string Property, string Current, string Replacement);
+
+internal static class TruckReplacementComparison
+{
+    public static IReadOnlyList<TruckComparisonRow> Build(RegionTruckEntry current, ReplacementTruck original, ReplacementTruck candidate)
+    {
+        var left = Values(original.Truck, new TruckEquipmentSummary(current.Tires, current.TireDetails, current.Addons, current.AddonDetails,
+            current.InstalledAddons, current.FrameAddons, current.FrameAddonDetails, current.InternalEquipment), original.Properties);
+        var right = Values(candidate.Truck, candidate.Equipment, candidate.Properties);
+        return left.Keys.Concat(right.Keys).Distinct(StringComparer.OrdinalIgnoreCase)
+            .Select(key => new TruckComparisonRow(key, left.GetValueOrDefault(key, "Not specified"), right.GetValueOrDefault(key, "Not specified"))).ToArray();
+    }
+
+    private static Dictionary<string, string> Values(CustomTruck truck, TruckEquipmentSummary equipment, IReadOnlyDictionary<string, string> properties)
+    {
+        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
+        { ["Truck"] = truck.Name, ["Class"] = truck.Class, ["Truck ID"] = truck.Code, ["Wheels / Installed category"] = equipment.Tires,
+            ["Wheels / Installed tire, rim and scale"] = equipment.TireDetails };
+        foreach (var item in equipment.InternalEquipment ?? [])
+        {
+            if (item.Slot == "Vehicle definition") continue;
+            values["Internal / " + item.Slot] = item.Name;
+            foreach (var line in item.DefinitionDetails.Split(["\r\n", "\n"], StringSplitOptions.RemoveEmptyEntries))
+            {
+                var separator = line.IndexOf('=');
+                if (separator < 0) continue;
+                var key = Regex.Replace(line[..separator], @"^(Engine|Gearbox|Winch|SuspensionSet)\[\d+\]\.", "$1.");
+                values["Internal settings / " + item.Slot + " / " + key] = line[(separator + 1)..];
+            }
+            if (item.DefinitionDetails.Contains("no matching definition", StringComparison.OrdinalIgnoreCase))
+                values["Internal resolution / " + item.Slot] = "Selected ID has no matching workspace definition";
+        }
+        if (equipment.InstalledAddons is null) values["Installed addons"] = "Unknown — map equipment could not be read";
+        else foreach (var group in equipment.InstalledAddons.GroupBy(addon => addon.Category.Length == 0 ? "Uncategorized" : addon.Category))
+            values["Installed addons / " + group.Key.Replace('_', ' ')] = string.Join("\r\n", group.Select(addon => addon.Name).Order(StringComparer.CurrentCultureIgnoreCase));
+        foreach (var (key, value) in properties) values[key] = value.Length == 0 ? "None specified" : value;
+        return values;
+    }
+}
+
+/// <summary>Read-only preparation of a replacement; candidate equipment uses vehicle defaults.</summary>
+internal sealed class TruckReplacementDialog : Form
+{
+    private readonly RegionTruckEntry _current;
