+        Check(grid.Rows.Count==166,"review table contains original/current rows");
+        Check(grid.Rows.Cast<DataGridViewRow>().Any(r=>Convert.ToString(r.Cells["Change state"].Value)=="Draft"),"review table shows changed draft rows");
