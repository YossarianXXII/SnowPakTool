 ### SnowPakTool Desktop UI
 
+**Editors → Addons** provides a read-only addon/upgrade catalog using Cargo's main table, description and source-properties layout. Reload runs in the background. Shared column sorting/filtering covers names, type/category, IDs and ID scope, socket/component family, content, price, rank, exploration flag and map reward references. Selecting an item lists each level SSO's map, zone and reward index, plus XML properties and their source files. Explicit file parents are followed; templates remain visible source data without expansion, and full truck compatibility is not inferred. Tire names are local to their wheel family; unresolved map reward IDs remain clearly marked. This does not stage or edit game data. See [the upgrade investigation](upgrade-map-investigation.md) for the confirmed map-zone → level-settings → part-definition relationship and replacement limits.
+
 **Randomizer → Upgrades** prepares the upgrade workflow with one full-width rule pane, matching Truck randomization's add/edit/remove glyphs, automatically saved notes, Randomize / Stage changes buttons, detailed-log toggle and message area. Rules start empty and save separately from truck rules; an intentionally empty list remains empty. **Randomizer → Map upgrades** matches Map trucks' region tiles, map-folder Browse / Reload controls, region selection buttons, reset/staging controls, sortable/filterable table and resizable details split. Region tiles load from workspace metadata. Upgrade placement reading, replacement, randomization, reset and staging are not implemented yet; their action buttons remain disabled. Browse selects a folder and Reload refreshes workspace region metadata; neither scans upgrade placements or writes game files. Redistribution rules will be defined separately.
 
 **Start → PAK** groups truck XML changes into one brief row per truck and state, using the localized truck name. The summary shows up to three readable field/value changes (for example fuel capacity, price, unlock rank, engine or winch compatibility), followed by a count of further changes. Hover for every original field, before/after value and source path. Pending and applied summaries retain their distinct colors. Rank XP, shared engine/winch definitions, addon files and other general edits remain separate entries. Grouping affects display only; Apply and pending counts still use the full underlying edit list.
diff --git a/src/SnowPakTool.Desktop/AddonCatalogService.cs b/src/SnowPakTool.Desktop/AddonCatalogService.cs
new file mode 100644
index 0000000..beca56a
--- /dev/null
+++ b/src/SnowPakTool.Desktop/AddonCatalogService.cs
@@ -0,0 +1,172 @@
+using System.Globalization;
+using System.Xml;
+using System.Xml.Linq;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed record UpgradeMapReference(string Map, string Zone, int Index, string UpgradeId, string Source);
+internal sealed record AddonCatalogProperty(string Source, string Property, string Value);
+internal sealed record AddonCatalogEntry(string Name, string Type, string Category, string Id, string Family,
+    string Content, decimal? Price, decimal? UnlockRank, string Exploration, string Description, string Source,
+    IReadOnlyList<UpgradeMapReference> MapReferences, IReadOnlyList<AddonCatalogProperty> Properties);
+internal sealed record AddonCatalog(IReadOnlyList<AddonCatalogEntry> Entries,
+    IReadOnlyList<UpgradeMapReference> MapReferences, IReadOnlyList<string> Warnings);
+
+internal static class AddonCatalogService
+{
+    private sealed record Definition(string Path, string Relative, XElement Root, XElement Xml);
+
+    public static AddonCatalog Load(string workspace, IReadOnlyDictionary<string, string> names)
+    {
+        var warnings = new List<string>();
+        var references = ReadMapReferences(workspace, warnings);
+        var referencesById = references.GroupBy(item => item.UpgradeId, StringComparer.OrdinalIgnoreCase)
+            .ToDictionary(group => group.Key, group => (IReadOnlyList<UpgradeMapReference>)group.ToArray(), StringComparer.OrdinalIgnoreCase);
+        var definitions = new List<Definition>();
+        foreach (var path in WorkspaceOriginals.EnumerateCurrentFiles(workspace, "[media]", "*.xml"))
+        {
+            var relative = WorkspaceOriginals.GetRelativePath(workspace, path).Replace('\\', '/');
+            if (!new[] { "trucks", "engines", "gearboxes", "suspensions", "winches", "wheels" }
+                    .Any(folder => relative.Contains("/classes/" + folder + "/", StringComparison.OrdinalIgnoreCase))) continue;
+            try
+            {
+                var root = new XElement("Root");
+                using var reader = XmlReader.Create(new StringReader(WorkspaceDataCache.ReadAllText(path)),
+                    new XmlReaderSettings { ConformanceLevel = ConformanceLevel.Fragment, DtdProcessing = DtdProcessing.Prohibit });
+                while (!reader.EOF)
+                {
+                    if (reader.NodeType != XmlNodeType.Element) { reader.Read(); continue; }
+                    root.Add(XNode.ReadFrom(reader));
+                }
+                var xml = root.Elements().FirstOrDefault(element => !element.Name.LocalName.StartsWith('_'));
+                if (xml is not null) definitions.Add(new(path, relative, root, xml));
+            }
+            catch (Exception ex) when (ex is XmlException or IOException or UnauthorizedAccessException)
+            { warnings.Add($"{relative}: {ex.Message}"); }
+        }
+        var byPath = definitions.ToDictionary(item => Path.GetFullPath(item.Path), StringComparer.OrdinalIgnoreCase);
+        var byName = definitions.GroupBy(item => Path.GetFileNameWithoutExtension(item.Path), StringComparer.OrdinalIgnoreCase)
+            .ToDictionary(group => group.Key, group => group.ToArray(), StringComparer.OrdinalIgnoreCase);
+        var entries = new List<AddonCatalogEntry>();
+        foreach (var definition in definitions)
+        {
+            var kind = definition.Xml.Name.LocalName;
+            if (kind == "TruckAddon") Add(definition.Xml, "Addon", Path.GetFileNameWithoutExtension(definition.Path));
+            else
+                foreach (var variant in definition.Xml.Descendants().Where(element => element.Name.LocalName is
+                             "Engine" or "Gearbox" or "SuspensionSet" or "Winch" or "TruckTire"))
+                {
+                    var id = (string?)variant.Attribute("Name");
+                    if (!string.IsNullOrEmpty(id)) Add(variant, variant.Name.LocalName == "SuspensionSet" ? "Suspension" :
+                        variant.Name.LocalName == "TruckTire" ? "Tire" : variant.Name.LocalName, id);
+                }
+
+            void Add(XElement xml, string type, string id)
+            {
+                // Follow file parents for explicitly defined metadata. Shared/local template
+                // expansion and complete installation compatibility are deliberately not inferred.
+                var chain = new List<(Definition Definition, XElement Xml)> { (definition, xml) };
+                var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { definition.Path };
+                var current = definition;
+                while ((string?)current.Root.Element("_parent")?.Attribute("File") is { Length: > 0 } parent)
+                {
+                    var local = Path.GetFullPath(Path.Combine(Path.GetDirectoryName(current.Path)!, parent + ".xml"));
+                    if (!byPath.TryGetValue(local, out var next))
+                    {
+                        var code = Path.GetFileNameWithoutExtension(parent);
+                        if (!byName.TryGetValue(code, out var candidates) || candidates.Length != 1)
+                        { warnings.Add($"{current.Relative}: missing or ambiguous parent {parent}."); break; }
+                        next = candidates[0];
+                    }
+                    if (!seen.Add(next.Path)) { warnings.Add($"{definition.Relative}: cyclic file parent."); break; }
+                    var inherited = type == "Addon" ? next.Xml : next.Xml.Descendants()
+                        .FirstOrDefault(element => element.Name == xml.Name && (string?)element.Attribute("Name") == id);
+                    if (inherited is null) break;
+                    chain.Add((next, inherited));
+                    current = next;
+                }
+                string? Field(string path, string attribute)
+                {
+                    foreach (var item in chain)
+                    {
+                        XElement? node = item.Xml;
+                        var blocked = (string?)node.Attribute("_noinherit") == "true";
+                        foreach (var part in path.Split('/', StringSplitOptions.RemoveEmptyEntries))
+                        {
+                            node = node?.Element(part);
+                            blocked |= (string?)node?.Attribute("_noinherit") == "true";
+                        }
+                        if ((string?)node?.Attribute(attribute) is { } value) return value;
+                        if (blocked) return null;
+                    }
+                    return null;
+                }
+                string Label(string? key, string fallback) => key is null ? fallback : names.TryGetValue(key, out var value) ? value : key;
+                var properties = new List<AddonCatalogProperty>();
+                foreach (var item in chain)
+                {
+                    Collect(item.Definition.Relative, item.Xml, "", properties);
+                    if (item.Definition.Root.Element("_parent") is { } parent) Collect(item.Definition.Relative, parent, "", properties);
+                    if (item.Definition.Root.Element("_templates") is { } templates) Collect(item.Definition.Relative, templates, "", properties);
+                }
+                var parts = definition.Relative.Split('/');
+                var dlc = Array.FindIndex(parts, part => part.Equals("_dlc", StringComparison.OrdinalIgnoreCase));
+                entries.Add(new(Label(Field("GameData/UiDesc", "UiName"), id), type, Field("GameData", "Category") ?? "",
+                    id, type == "Addon" ? Field("GameData/InstallSocket", "Type") ?? "" : Path.GetFileNameWithoutExtension(definition.Path),
+                    dlc >= 0 && dlc + 1 < parts.Length ? parts[dlc + 1] : "Base game",
+                    Number(Field("GameData", "Price")), Number(Field("GameData", "UnlockByRank")), Field("GameData", "UnlockByExploration") ?? "",
+                    Label(Field("GameData/UiDesc", "UiDesc"), ""), definition.Relative,
+                    referencesById.GetValueOrDefault(id) ?? [], properties));
+            }
+        }
+        var known = entries.Select(entry => entry.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
+        foreach (var group in referencesById.Where(pair => !known.Contains(pair.Key)))
+        {
+            warnings.Add($"Upgrade ID '{group.Key}' is referenced by level settings but has no catalog definition.");
+            entries.Add(new(group.Key, "Unresolved map upgrade", "", group.Key, "", "Unknown", null, null, "", "No definition found in this workspace.", "", group.Value, []));
+        }
+        return new(entries.OrderBy(entry => entry.Name, StringComparer.CurrentCultureIgnoreCase).ThenBy(entry => entry.Id)
+            .ThenBy(entry => entry.Source).ToArray(), references, warnings.Distinct().ToArray());
+    }
+
+    internal static IReadOnlyList<UpgradeMapReference> ReadMapReferences(string workspace, List<string> warnings)
+    {
+        var result = new List<UpgradeMapReference>();
+        foreach (var path in WorkspaceOriginals.EnumerateCurrentFiles(workspace, "[ps]", "*.sso")
+                     .Where(path => Path.GetFileName(path).StartsWith("level_", StringComparison.OrdinalIgnoreCase)))
+        {
+            var relative = WorkspaceOriginals.GetRelativePath(workspace, path);
+            try
+            {
+                var root = SsoDataReader.Parse(WorkspaceDataCache.ReadAllText(path));
+                if (!root.Members.TryGetValue("zoneDesc", out var zones)) continue;
+                foreach (var (zone, settings) in zones.Members)
+                {
+                    if (!settings.Members.TryGetValue("props", out var props)
+                        || !props.Members.TryGetValue("ZonePropertyUpgradesGiver", out var giver)
+                        || !giver.Members.TryGetValue("upgrades", out var upgrades)) continue;
+                    for (var index = 0; index < upgrades.Items.Count; index++)
+                    {
+                        var id = upgrades.Items[index].Text;
+                        if (string.IsNullOrWhiteSpace(id)) { warnings.Add($"{relative}: {zone} upgrade {index} has no scalar ID."); continue; }
+                        result.Add(new(Path.GetFileNameWithoutExtension(path), zone, index, id, relative));
+                    }
+                }
+            }
+            catch (Exception ex) when (ex is FormatException or IOException or UnauthorizedAccessException)
+            { warnings.Add($"{relative}: {ex.Message}"); }
+        }
+        return result;
+    }
+
+    private static decimal? Number(string? value) => decimal.TryParse(value, NumberStyles.Float, CultureInfo.InvariantCulture, out var number) ? number : null;
+
+    private static void Collect(string source, XElement element, string parent, List<AddonCatalogProperty> result)
+    {
+        var siblings = element.Parent?.Elements(element.Name).ToArray();
+        var suffix = siblings is { Length: > 1 } ? $"[{Array.IndexOf(siblings, element) + 1}]" : "";
+        var path = parent + element.Name.LocalName + suffix;
+        foreach (var attribute in element.Attributes()) result.Add(new(source, path + "/@" + attribute.Name, attribute.Value));
+        foreach (var child in element.Elements()) Collect(source, child, path + "/", result);
+    }
+}
diff --git a/src/SnowPakTool.Desktop/AddonsTab.cs b/src/SnowPakTool.Desktop/AddonsTab.cs
new file mode 100644
index 0000000..22612b6
--- /dev/null
+++ b/src/SnowPakTool.Desktop/AddonsTab.cs
@@ -0,0 +1,153 @@
+using System.Data;
+
+namespace SnowPakTool.Desktop;
+
+internal sealed class AddonsTab : UserControl
+{
+    private readonly Func<string> _getWorkspacePath;
+    private readonly Label _status = new() { AutoSize = true, Padding = new Padding(4, 6, 4, 4) };
+    private readonly TextBox _description = new() { Dock = DockStyle.Fill, Multiline = true, ReadOnly = true, ScrollBars = ScrollBars.Vertical };
+    private readonly DataGridView _addons = CreateGrid();
+    private readonly DataGridView _properties = CreateGrid();
+    private AddonCatalog? _catalog;
+    private string? _loadedWorkspace;
+    private bool _loading;
+    private readonly Button _reload = new() { Text = "Reload addons", AutoSize = true };
+
+    public AddonsTab(Func<string> getWorkspacePath)
+    {
+        _getWorkspacePath = getWorkspacePath;
+        var layout = new TableLayoutPanel { Dock = DockStyle.Fill, Padding = new Padding(12), ColumnCount = 1, RowCount = 5 };
+        layout.RowStyles.Add(new RowStyle(SizeType.AutoSize));
+        layout.RowStyles.Add(new RowStyle(SizeType.AutoSize));
+        layout.RowStyles.Add(new RowStyle(SizeType.Percent, 60));
+        layout.RowStyles.Add(new RowStyle(SizeType.Absolute, 64));
+        layout.RowStyles.Add(new RowStyle(SizeType.Percent, 40));
+        var toolbar = new FlowLayoutPanel { AutoSize = true, Dock = DockStyle.Fill };
+        toolbar.Controls.Add(new Label { Text = "Addons", AutoSize = true, Font = new Font(Font, FontStyle.Bold), Padding = new Padding(0, 5, 12, 0) });
+        toolbar.Controls.Add(_reload);
+        layout.Controls.Add(toolbar, 0, 0);
+        layout.Controls.Add(_status, 0, 1);
+        layout.Controls.Add(_addons, 0, 2);
+        layout.Controls.Add(_description, 0, 3);
+        layout.Controls.Add(_properties, 0, 4);
+        Controls.Add(layout);
+        _properties.Columns.Add("Property", "Selected addon / upgrade property");
+        _properties.Columns.Add("Value", "Value");
+        _properties.Columns.Add("Source", "Source file");
+        _properties.AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill;
+        TableHeaderBehavior.Attach(_addons);
+        TableHeaderBehavior.Attach(_properties);
+        _addons.CurrentCellChanged += (_, _) => ShowProperties();
+        _addons.DataBindingComplete += (_, _) => ShowProperties();
+        _reload.Click += async (_, _) => await LoadAsync(force: true);
+        AppColors.Changed += RefreshColors;
+        Disposed += (_, _) => AppColors.Changed -= RefreshColors;
+        RefreshColors(this, EventArgs.Empty);
+    }
+
+    public void EnsureLoaded() => _ = EnsureLoadedAsync();
+
+    public Task EnsureLoadedAsync() => LoadAsync(force: false);
+
+    private async Task LoadAsync(bool force)
+    {
+        if (_loading || IsDisposed) return;
+        var workspace = _getWorkspacePath().Trim();
+        if (!force && string.Equals(_loadedWorkspace, workspace, StringComparison.OrdinalIgnoreCase)) return;
+        _catalog = null;
+        _loadedWorkspace = null;
+        _addons.DataSource = null;
+        _properties.Rows.Clear();
+        _description.Clear();
+        if (workspace.Length == 0 || !Directory.Exists(workspace))
+        {
+            _status.Text = "Choose an extracted workspace on the Start tab to list addons and upgrades.";
+            return;
+        }
+        _loading = true;
+        _reload.Enabled = false;
+        _status.Text = "Reading addon/component definitions and level upgrade rewards…";
+        try
+        {
+            if (force) await WorkspaceDataCache.PreloadAsync(workspace, forceReload: true);
+            else await WorkspaceDataCache.PreloadOwnedAsync(workspace);
+            var names = WorkspaceDataCache.GetLocalizedNames(workspace);
+            var catalog = await Task.Run(() => AddonCatalogService.Load(workspace, names));
+            if (IsDisposed || !string.Equals(workspace, _getWorkspacePath().Trim(), StringComparison.OrdinalIgnoreCase)) return;
+            _catalog = catalog;
+            _loadedWorkspace = workspace;
+            ApplyFilter();
+        }
+        catch (Exception ex) { if (!IsDisposed) _status.Text = $"Could not load addons: {ex.Message}"; }
+        finally
+        {
+            _loading = false;
+            if (!IsDisposed)
+            {
+                _reload.Enabled = true;
+                if (!string.Equals(workspace, _getWorkspacePath().Trim(), StringComparison.OrdinalIgnoreCase)) await LoadAsync(force: false);
+            }
+        }
+    }
+
+    private void ApplyFilter()
+    {
+        if (_catalog is null) return;
+        var visible = _catalog.Entries;
+        var table = new DataTable();
+        foreach (var column in new[] { "Addon / upgrade", "Type", "Category", "ID", "ID scope", "Socket / family", "Content", "Exploration unlock", "Referenced maps", "Source file" }) table.Columns.Add(column);
+        foreach (var column in new[] { "Price", "Unlock rank", "Map reward entries" }) table.Columns.Add(column, typeof(decimal));
+        table.Columns.Add("Entry", typeof(AddonCatalogEntry));
+        foreach (var entry in visible)
+            table.Rows.Add(entry.Name, entry.Type, entry.Category, entry.Id, entry.Type == "Tire" ? "Local tire name" : entry.Type == "Unresolved map upgrade" ? "Unresolved reward ID" : "Global upgrade ID", entry.Family, entry.Content, entry.Exploration,
+                string.Join(", ", entry.MapReferences.Select(item => item.Map).Distinct(StringComparer.OrdinalIgnoreCase)), entry.Source,
+                (object?)entry.Price ?? DBNull.Value, (object?)entry.UnlockRank ?? DBNull.Value, (decimal)entry.MapReferences.Count, entry);
+        _addons.DataSource = table;
+        _addons.Columns["Entry"]!.Visible = false;
+        foreach (DataGridViewColumn column in _addons.Columns)
+        {
+            column.Width = column.Name switch { "Addon / upgrade" => 210, "ID" or "Socket / family" => 260, "Referenced maps" or "Source file" => 300, _ => 125 };
+            if (column.ValueType == typeof(decimal)) column.DefaultCellStyle.Format = "N0";
+        }
+        _status.Text = $"{visible.Count} addon/component definitions · {_catalog.MapReferences.Count} level-setting reward entries. "
+            + "Read-only catalog. Header funnels filter columns; map references do not verify physical zones.";
+        if (_catalog.Warnings.Count > 0) _status.Text += $" {_catalog.Warnings.Count} warnings (see details).";
+        ShowProperties();
+    }
+
+    private void ShowProperties()
+    {
+        _properties.Rows.Clear();
+        _description.Clear();
+        if (_addons.CurrentRow?.DataBoundItem is not DataRowView row || row["Entry"] is not AddonCatalogEntry entry) return;
+        _description.Text = entry.Description + Environment.NewLine
+            + "Metadata follows explicit file parents; shared/local templates are shown below without expansion. Blank = not resolved. Socket/family identifies definitions, not guaranteed truck compatibility. Tire names are local to their wheel family and are not automatically treated as global reward IDs."
+            + (_catalog?.Warnings.Count > 0 ? Environment.NewLine + string.Join(Environment.NewLine, _catalog.Warnings) : "");
+        foreach (var reference in entry.MapReferences)
+            _properties.Rows.Add($"Map reward: {reference.Map} / {reference.Zone} / upgrades[{reference.Index}]", reference.UpgradeId, reference.Source);
+        foreach (var property in entry.Properties) _properties.Rows.Add(property.Property, property.Value, property.Source);
+        TableHeaderBehavior.Refresh(_properties);
+    }
+
+    private void RefreshColors(object? sender, EventArgs e)
+    {
+        foreach (var grid in new[] { _addons, _properties })
+        {
+            grid.BackgroundColor = grid.DefaultCellStyle.BackColor = AppColors.Get("Surface");
+            grid.AlternatingRowsDefaultCellStyle.BackColor = AppColors.Get("AlternateRow");
+            grid.DefaultCellStyle.SelectionBackColor = AppColors.Get("SelectionBlue");
+            grid.DefaultCellStyle.SelectionForeColor = SystemColors.ControlText;
+        }
+    }
+
+    private static DataGridView CreateGrid() => new()
+    {
+        Dock = DockStyle.Fill, ReadOnly = true, AllowUserToAddRows = false, AllowUserToDeleteRows = false,
+        AllowUserToResizeRows = false, RowHeadersVisible = false, MultiSelect = false,
+        SelectionMode = DataGridViewSelectionMode.FullRowSelect, AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.None,
+        Font = new Font(SystemFonts.MessageBoxFont!.FontFamily, 9f),
+        ColumnHeadersDefaultCellStyle = { Font = new Font(SystemFonts.MessageBoxFont!.FontFamily, 9f, FontStyle.Bold) },
+        RowTemplate = { Height = 26 }
+    };
+}
