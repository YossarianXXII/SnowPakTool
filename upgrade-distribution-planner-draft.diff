+using System.Text.Json;
+using SnowPakTool.Desktop;
+
+static class Program
+{
+    static void Check(bool value, string message) { if (!value) throw new Exception(message); }
+    static string Signature(UpgradeDistributionPlan plan) => string.Join("\n", plan.Assignments.Select(a => $"{a.Slot.Source}|{a.Slot.Zone}|{a.Slot.RewardIndex}|{a.UpgradeId}|{a.Relation}"));
+    static UpgradeDistributionSlot Slot(int index, string region, string id) => new($"[ps]/level_{region}_01.sso", $"level_{region}_01", region, $"ZONE_{index}", 0, id);
+    static void Reject(Action action, string message)
+    {
+        try { action(); }
+        catch (ArgumentException) { return; }
+        throw new Exception(message);
+    }
+
+    static void CheckPool(UpgradeDistributionInput input, UpgradeDistributionPlan plan)
+    {
+        var before = input.Slots.GroupBy(s => s.OriginalUpgradeId).ToDictionary(g => g.Key, g => g.Count());
+        var after = plan.Assignments.GroupBy(a => a.UpgradeId).ToDictionary(g => g.Key, g => g.Count());
+        Check(before.Count == after.Count && before.All(p => after.GetValueOrDefault(p.Key) == p.Value), "Exact reward multiset");
+        Check(plan.Assignments.Count == input.Slots.Count, "All pickup slots filled");
+        Check(plan.Report.OriginalTypes.All(p => plan.Report.PlannedTypes[p.Key] == p.Value), "All type counts preserved");
+        foreach (var assignment in plan.Assignments.Where(a => a.Kind == UpgradeKind.MetalDetector))
+            Check(assignment.UpgradeId == assignment.Slot.OriginalUpgradeId && assignment.Relation == UpgradePlacementRelation.Fixed, "Detector slot pinned");
+        Check(plan.Report.SpecificLocal + plan.Report.SpecificElsewhere == plan.Report.SpecificWithHome, "Locality denominator excludes absent trucks and generic items");
+    }
+
+    static UpgradeDistributionInput Fixture()
+    {
+        var definitions = new List<UpgradeDistributionDefinition>();
+        var homes = new List<UpgradeTruckHome>();
+        var slots = new List<UpgradeDistributionSlot>();
+        var regions = new[] { "aa", "bb", "cc", "dd" };
+        for (var index = 0; index < 40; index++)
+        {
+            var truck = "truck_" + index;
+            var id = "specific_" + index;
+            definitions.Add(new(id, index % 2 == 0 ? UpgradeKind.Engine : UpgradeKind.Suspension, [truck]));
+            homes.Add(new(truck, regions[index % regions.Length]));
+            slots.Add(Slot(index, regions[index % regions.Length], id));
+        }
+        // Half the shared items are useful in the first region; half serve only
+        // trucks elsewhere. All remain shared even if one compatible model is absent.
+        homes.Add(new("local_shared_a", "aa")); homes.Add(new("local_shared_b", "bb"));
+        homes.Add(new("foreign_shared_a", "cc")); homes.Add(new("foreign_shared_b", "dd"));
+        for (var index = 0; index < 16; index++)
+        {
+            var id = "shared_" + index;
+            definitions.Add(new(id, UpgradeKind.Gearbox, index < 8 ? ["local_shared_a", "local_shared_b"] : ["foreign_shared_a", "foreign_shared_b"]));
+            slots.Add(Slot(40 + index, regions[index % regions.Length], id));
+        }
+        for (var index = 0; index < 4; index++)
+        {
+            var id = "buyable_" + index;
+            definitions.Add(new(id, UpgradeKind.DifferentialLock, ["buyable_truck_" + index]));
+            slots.Add(Slot(56 + index, regions[index], id));
+        }
+        definitions.Add(new("metal_detector", UpgradeKind.MetalDetector, []));
+        slots.Add(Slot(60, "aa", "metal_detector"));
+        return new(slots, definitions, homes, regions);
+    }
+
+    static UpgradeDistributionInput RealFixture(string project)
+    {
+        using var document = JsonDocument.Parse(File.ReadAllText(Path.Combine(project, ".checks/UpgradeRegionAnalysis/results/original-trucks-upgrades.json")));
+        var root = document.RootElement;
+        var models = root.GetProperty("Models").EnumerateArray().ToArray();
+        var references = root.GetProperty("References").EnumerateArray().ToArray();
+        var info = root.GetProperty("RewardInfo");
+        var definitions = new List<UpgradeDistributionDefinition>();
+        foreach (var reference in references.DistinctBy(r => r.GetProperty("UpgradeId").GetString()))
+        {
+            var id = reference.GetProperty("UpgradeId").GetString()!;
+            var compatible = models.Where(m => m.GetProperty("CompatibleRewardIds").EnumerateArray().Any(v => v.GetString() == id))
+                .Select(m => m.GetProperty("Truck").GetString()!).ToArray();
+            UpgradeKind kind;
+            if (id == "wheels_extend_kirovets_k7m_tire_1") { kind = UpgradeKind.Tire; compatible = ["kirovets_k7m"]; }
+            else kind = info.GetProperty(id).GetProperty("Type").GetString() switch
+            {
+                "Engine" => UpgradeKind.Engine, "Suspension" => UpgradeKind.Suspension,
+                "Gearbox" => UpgradeKind.Gearbox, "awd" => UpgradeKind.Awd,
+                "diff_lock" => UpgradeKind.DifferentialLock,
+                "frame_addons" when id == "frame_addon_metal_detector" => UpgradeKind.MetalDetector,
+                _ => throw new Exception("Unresolved fixture item " + id)
+            };
+            definitions.Add(new(id, kind, compatible));
+        }
+        var homes = models.SelectMany(m => m.GetProperty("Regions").EnumerateArray()
+            .Select(region => new UpgradeTruckHome(m.GetProperty("Truck").GetString()!, region.GetString()!))).ToList();
+        // Verified direct garage reward: Starting The Plank Production, Maine.
+        homes.Add(new("tayga_6455b", "us_06"));
+        var slots = references.Select(r => new UpgradeDistributionSlot(r.GetProperty("Source").GetString()!, r.GetProperty("Map").GetString()!,
+            r.GetProperty("Region").GetString()!, r.GetProperty("Zone").GetString()!, r.GetProperty("Index").GetInt32(), r.GetProperty("UpgradeId").GetString()!)).ToArray();
+        var regions = slots.Select(s => s.Region).Distinct().OrderBy(code => code == "us_01" ? 0 : 1).ThenBy(code => code, StringComparer.Ordinal).ToArray();
+        return new(slots, definitions, homes, regions);
+    }
+
+    static void Main()
+    {
+        var input = Fixture();
+        var options = new UpgradeDistributionOptions(Attempts: 6, SwapsPerAttempt: 8000);
+        var first = UpgradeDistributionPlanner.Generate(input, 2345, options);
+        CheckPool(input, first);
+        Check(first.Report.SpecificWithHome == 40 && first.Report.SpecificWithoutHome == 4 && first.Report.Shared == 16, "Correct fixture categories");
+        Check(first.Report.SpecificLocal == first.Report.LocalTargetCount, "Feasible fixture reaches sampled locality target");
+        Check(Signature(first) == Signature(UpgradeDistributionPlanner.Generate(input, 2345, options)), "Repeatable seed");
+        Check(Signature(first) != Signature(UpgradeDistributionPlanner.Generate(input, 2346, options)), "Different seeds produce different plans");
+        var reordered = new UpgradeDistributionInput(input.Slots.Reverse().ToArray(), input.Definitions.Reverse().ToArray(), input.TruckHomes.Reverse().ToArray(), input.RegionOrder);
+        Check(Signature(first) == Signature(UpgradeDistributionPlanner.Generate(reordered, 2345, options)), "Order-independent caller snapshots");
+
+        var low = UpgradeDistributionPlanner.Generate(input, 333, options with { FirstRegionForeignSharedMinimum = 0, FirstRegionForeignSharedMaximum = 0 });
+        var high = UpgradeDistributionPlanner.Generate(input, 333, options with { FirstRegionForeignSharedMinimum = 1, FirstRegionForeignSharedMaximum = 1 });
+        CheckPool(input, low); CheckPool(input, high);
+        Check(high.Report.FirstRegionForeignShared > low.Report.FirstRegionForeignShared, "First-region bias changes shared foreign selection");
+        Check(high.Report.LocalTargetCount == low.Report.LocalTargetCount && high.Report.SpecificLocal == low.Report.SpecificLocal, "First-region foreign preference does not change the truck-specific locality target/result in feasible fixture");
+
+        var singleRegion = input with { Slots = input.Slots.Select(s => s with { Region = "aa" }).ToArray(), RegionOrder = ["aa"] };
+        var impossible = UpgradeDistributionPlanner.Generate(singleRegion, 5, options);
+        CheckPool(singleRegion, impossible);
+        Check(impossible.Report.SpecificLocal == 10 && impossible.Report.Notes.Any(n => n.Contains("no movable pickup slot")), "Impossible local target returns intact plan and honest shortfall");
+
+        var duplicateSlots = new[] { Slot(0,"aa","repeat"), Slot(1,"bb","repeat"), Slot(2,"bb","other") };
+        var repeated = new UpgradeDistributionInput(duplicateSlots, [new("repeat",UpgradeKind.Engine,["one"]),new("other",UpgradeKind.Gearbox,["one","two"])], [new("one","aa")], ["aa","bb"]);
+        CheckPool(repeated, UpgradeDistributionPlanner.Generate(repeated, 2, options));
+        var withNewTruckHome = input with { TruckHomes = input.TruckHomes.Concat(new[] { new UpgradeTruckHome("buyable_truck_0","aa") }).ToArray() };
+        var moved = UpgradeDistributionPlanner.Generate(withNewTruckHome, 4, options);
+        Check(moved.Report.SpecificWithHome == 41 && moved.Report.SpecificWithoutHome == 3, "Buyable part reclassified when its model becomes obtainable");
+        var multiHome = input with { TruckHomes = input.TruckHomes.Concat(new[] { new UpgradeTruckHome("truck_0","bb"), new UpgradeTruckHome("truck_0","aa") }).ToArray() };
+        Check(UpgradeDistributionPlanner.Generate(multiHome, 4, options).Report.SpecificWithHome == 40, "Multiple truck copies/regions do not multiply rewards");
+        var extraPin = input with { Definitions = input.Definitions.Select(d => d.Id == "buyable_0" ? d with { KeepInPlace = true } : d).ToArray() };
+        var pinned = UpgradeDistributionPlanner.Generate(extraPin, 4, options);
+        CheckPool(extraPin, pinned);
+        Check(pinned.Report.Fixed == 2 && pinned.Assignments.Single(a => a.Slot.OriginalUpgradeId == "buyable_0").UpgradeId == "buyable_0", "Additional explicit pins preserved");
+        var noForeign = input with { TruckHomes = input.TruckHomes.Concat(new[] { new UpgradeTruckHome("foreign_shared_a","aa") }).ToArray() };
+        var noForeignPlan = UpgradeDistributionPlanner.Generate(noForeign, 4, options);
+        Check(noForeignPlan.Report.FirstRegionForeignShared == 0 && noForeignPlan.Report.Notes.Any(n => n.Contains("no foreign shared candidate")), "Unavailable first-region generic target is reported without fabricating candidates");
+
+        Reject(() => UpgradeDistributionPlanner.Generate(input with { Definitions = input.Definitions.Skip(1).ToArray() },1), "Unknown rewards must fail");
+        Reject(() => UpgradeDistributionPlanner.Generate(input with { Slots = input.Slots.Concat(new[] { input.Slots[0] }).ToArray() },1), "Duplicate slot identity must fail");
+        Reject(() => UpgradeDistributionPlanner.Generate(input,1,options with { LocalMinimum = double.NaN }), "Invalid probability must fail");
+        Reject(() => UpgradeDistributionPlanner.Generate(input with { RegionOrder = ["aa"] },1), "Missing progression region must fail");
+        var empty = UpgradeDistributionPlanner.Generate(new([],[],[],[]),1);
+        Check(empty.Assignments.Count == 0 && empty.Report.Notes.Count > 0,"Empty scope supported");
+
+        var project = Path.GetFullPath(Path.Combine(AppContext.BaseDirectory,"../../../../.."));
+        var realInput = RealFixture(project);
+        var timer = System.Diagnostics.Stopwatch.StartNew();
+        var real = UpgradeDistributionPlanner.Generate(realInput, 20261104);
+        CheckPool(realInput, real);
+        Check(real.Assignments.Count == 166 && real.Report.Fixed == 1 && real.Report.SpecificWithoutHome == 16
+            && real.Report.SpecificWithHome == 111 && real.Report.Shared == 38, "166-item baseline including tire, contract reward and fixed detector");
+        var output = Path.Combine(project,".checks/UpgradePlannerRegression/results"); Directory.CreateDirectory(output);
+        File.WriteAllText(Path.Combine(output,"example-plan.json"),JsonSerializer.Serialize(real,new JsonSerializerOptions { WriteIndented = true }));
+        var models = realInput.Definitions.SelectMany(d => d.CompatibleTrucks).Distinct().Order(StringComparer.Ordinal).ToArray();
+        var random = new Random(4567);
+        var randomizedInput = realInput with { TruckHomes = realInput.TruckHomes.Select(home => home.Truck == "tayga_6455b"
+            ? home : home with { Truck = models[random.Next(models.Length)] }).ToArray() };
+        var randomized = UpgradeDistributionPlanner.Generate(randomizedInput, 20261104);
+        CheckPool(randomizedInput, randomized);
+        Check(randomized.Report.SpecificWithHome != real.Report.SpecificWithHome, "Uses supplied randomized truck homes instead of original fixed quotas");
+        var definitionMap = randomizedInput.Definitions.ToDictionary(d => d.Id);
+        foreach (var assignment in randomized.Assignments.Where(a => a.Relation != UpgradePlacementRelation.Fixed))
+        {
+            var compatible = definitionMap[assignment.UpgradeId].CompatibleTrucks;
+            var homes = randomizedInput.TruckHomes.Where(h => compatible.Contains(h.Truck)).Select(h => h.Region).Distinct().ToArray();
+            var expected = compatible.Count == 1
+                ? homes.Length == 0 ? UpgradePlacementRelation.SpecificWithoutHome : homes.Contains(assignment.Slot.Region) ? UpgradePlacementRelation.SpecificLocal : UpgradePlacementRelation.SpecificElsewhere
+                : homes.Contains(assignment.Slot.Region) ? UpgradePlacementRelation.SharedLocal : UpgradePlacementRelation.SharedForeign;
+            Check(assignment.Relation == expected, "Reported relation agrees with independently joined randomized homes");
+        }
+        File.WriteAllText(Path.Combine(output,"randomized-homes-plan.json"),JsonSerializer.Serialize(randomized,new JsonSerializerOptions { WriteIndented = true }));
+        Console.WriteLine($"PASS planner invariants, deterministic seeds/order, bias isolation, impossible targets, buyable transitions, multi-region copies, duplicate rewards and validation.");
+        Console.WriteLine($"Original 166-slot example: local {real.Report.SpecificLocal}/{real.Report.SpecificWithHome} (target {real.Report.LocalTargetCount}), elsewhere {real.Report.SpecificElsewhere}, no-home {real.Report.SpecificWithoutHome}, movable shared {real.Report.Shared}, fixed {real.Report.Fixed}; first-region foreign shared {real.Report.FirstRegionForeignShared}/{real.Report.FirstRegionShared}; {timer.Elapsed.TotalSeconds:F2}s.");
+        foreach (var note in real.Report.Notes) Console.WriteLine(note);
+    }
+}
