@@ -0,0 +1,292 @@
+namespace SnowPakTool.Desktop;
+
+internal enum UpgradeKind { Engine, Suspension, Gearbox, DifferentialLock, Awd, Tire, MetalDetector }
+internal enum UpgradePlacementRelation { SpecificLocal, SpecificElsewhere, SpecificWithoutHome, SharedLocal, SharedForeign, Fixed }
+
+// Compatibility must describe the full truck catalog, not just trucks currently
+// present on maps. IDs are exact reward IDs (including composite tire IDs).
+internal sealed record UpgradeDistributionDefinition(string Id, UpgradeKind Kind,
+    IReadOnlyList<string> CompatibleTrucks, bool KeepInPlace = false);
+internal sealed record UpgradeDistributionSlot(string Source, string Map, string Region,
+    string Zone, int RewardIndex, string OriginalUpgradeId);
+// Include effective obtainable map placements and direct garage/contract awards.
+// Exclude mission-only and unverified trucks; repeated copies are harmless.
+internal sealed record UpgradeTruckHome(string Truck, string Region);
+internal sealed record UpgradeDistributionInput(IReadOnlyList<UpgradeDistributionSlot> Slots,
+    IReadOnlyList<UpgradeDistributionDefinition> Definitions, IReadOnlyList<UpgradeTruckHome> TruckHomes,
+    IReadOnlyList<string> RegionOrder);
+internal sealed record UpgradeDistributionOptions(
+    double LocalMinimum = .82, double LocalMaximum = .91,
+    double FirstRegionForeignSharedMinimum = .60, double FirstRegionForeignSharedMaximum = .75,
+    int Attempts = 12, int SwapsPerAttempt = 12000);
+internal sealed record UpgradeDistributionAssignment(UpgradeDistributionSlot Slot, string UpgradeId,
+    UpgradeKind Kind, UpgradePlacementRelation Relation);
+internal sealed record UpgradeRegionDistribution(string Region, int Total,
+    IReadOnlyDictionary<UpgradeKind, int> Types, int SpecificLocal, int SpecificElsewhere,
+    int SpecificWithoutHome, int SharedLocal, int SharedForeign, int Fixed);
+internal sealed record UpgradeDistributionReport(double LocalTarget, int LocalTargetCount,
+    int SpecificWithHome, int SpecificLocal, int SpecificElsewhere, int SpecificWithoutHome,
+    int Shared, int Fixed, string? FirstRegion, double FirstRegionForeignSharedTarget,
+    int FirstRegionShared, int FirstRegionForeignShared,
+    IReadOnlyDictionary<UpgradeKind, int> OriginalTypes, IReadOnlyDictionary<UpgradeKind, int> PlannedTypes,
+    IReadOnlyList<UpgradeRegionDistribution> Regions, IReadOnlyList<string> Notes);
+internal sealed record UpgradeDistributionPlan(int Seed, IReadOnlyList<UpgradeDistributionAssignment> Assignments,
+    UpgradeDistributionReport Report);
+
+/// <summary>
+/// Pure draft planner: permutes the supplied reward occurrences among their slots.
+/// No file access, saved-state mutation, staging or game writes. Locality, regional
+/// type mix and first-region shared-item bias are soft goals; pool and pins are exact.
+/// </summary>
+internal static class UpgradeDistributionPlanner
+{
+    private static readonly StringComparer Codes = StringComparer.OrdinalIgnoreCase;
+    private static readonly UpgradeKind[] Kinds = Enum.GetValues<UpgradeKind>();
+    private sealed record Item(string Id, UpgradeKind Kind, bool Specific, HashSet<string> Homes);
+
+    public static UpgradeDistributionPlan Generate(UpgradeDistributionInput input, int seed,
+        UpgradeDistributionOptions? options = null)
+    {
+        ArgumentNullException.ThrowIfNull(input);
+        ArgumentNullException.ThrowIfNull(input.Slots);
+        ArgumentNullException.ThrowIfNull(input.Definitions);
+        ArgumentNullException.ThrowIfNull(input.TruckHomes);
+        ArgumentNullException.ThrowIfNull(input.RegionOrder);
+        options ??= new();
+        ValidateOptions(options);
+        var slots = input.Slots.ToArray();
+        foreach (var slot in slots)
+            if (slot is null || Blank(slot.Source, slot.Map, slot.Region, slot.Zone, slot.OriginalUpgradeId) || slot.RewardIndex < 0)
+                throw new ArgumentException("Each pickup needs a source, map, region, zone, reward index and original upgrade ID.");
+        Array.Sort(slots, (a, b) => StringComparer.Ordinal.Compare(Key(a), Key(b)));
+        if (slots.Select(Key).Distinct(Codes).Count() != slots.Length)
+            throw new ArgumentException("Pickup identities must be unique, including the reward array index.");
+        var regions = input.RegionOrder.ToArray();
+        if (regions.Any(string.IsNullOrWhiteSpace) || regions.Distinct(Codes).Count() != regions.Length)
+            throw new ArgumentException("Region progression must contain unique, non-empty region codes.");
+        var regionIndex = regions.Select((code, index) => (code, index)).ToDictionary(p => p.code, p => p.index, Codes);
+        if (slots.Any(slot => !regionIndex.ContainsKey(slot.Region)))
+            throw new ArgumentException("Every pickup region must be present in the supplied region progression.");
+        var definitions = new Dictionary<string, UpgradeDistributionDefinition>(Codes);
+        foreach (var definition in input.Definitions)
+        {
+            if (definition is null || Blank(definition.Id) || !Enum.IsDefined(definition.Kind)
+                || definition.CompatibleTrucks is null || definition.CompatibleTrucks.Any(string.IsNullOrWhiteSpace))
+                throw new ArgumentException("Upgrade definitions require valid IDs, types and compatibility lists.");
+            if (!definitions.TryAdd(definition.Id, definition))
+                throw new ArgumentException($"Merge compatibility before planning: duplicate definition '{definition.Id}'.");
+        }
+        var homes = new Dictionary<string, HashSet<string>>(Codes);
+        foreach (var home in input.TruckHomes)
+        {
+            if (home is null || Blank(home.Truck, home.Region)) throw new ArgumentException("Truck home codes cannot be empty.");
+            if (!homes.TryGetValue(home.Truck, out var values)) homes[home.Truck] = values = new(Codes);
+            values.Add(home.Region);
+        }
+        var items = new Item[slots.Length];
+        var pinned = new bool[slots.Length];
+        for (var index = 0; index < slots.Length; index++)
+        {
+            if (!definitions.TryGetValue(slots[index].OriginalUpgradeId, out var definition))
+                throw new ArgumentException($"Unresolved pickup reward '{slots[index].OriginalUpgradeId}'. Supply a verified definition before planning.");
+            pinned[index] = definition.KeepInPlace || definition.Kind == UpgradeKind.MetalDetector;
+            var compatible = definition.CompatibleTrucks.Distinct(Codes).ToArray();
+            if (!pinned[index] && compatible.Length == 0)
+                throw new ArgumentException($"Upgrade '{definition.Id}' has no verified compatible trucks.");
+            var itemHomes = compatible.Where(homes.ContainsKey).SelectMany(code => homes[code]).ToHashSet(Codes);
+            items[index] = new(slots[index].OriginalUpgradeId, definition.Kind, compatible.Length == 1, itemHomes);
+        }
+        var random = new Random(seed);
+        var localTarget = Between(random, options.LocalMinimum, options.LocalMaximum);
+        var firstTarget = Between(random, options.FirstRegionForeignSharedMinimum, options.FirstRegionForeignSharedMaximum);
+        var movable = Enumerable.Range(0, slots.Length).Where(i => !pinned[i]).ToArray();
+        var eligible = movable.Count(i => items[i].Specific && items[i].Homes.Count > 0);
+        var desired = localTarget * eligible;
+        var localTargetCount = (int)Math.Floor(desired) + (random.NextDouble() < desired - Math.Floor(desired) ? 1 : 0);
+        var slotRegions = slots.Select(slot => regionIndex[slot.Region]).ToArray();
+        var originalTypes = TypeCounts(items.Select(item => item.Kind));
+        var targetTypes = new int[regions.Length, Kinds.Length];
+        var capacities = new int[regions.Length];
+        foreach (var slot in movable)
+        {
+            targetTypes[slotRegions[slot], (int)items[slot].Kind]++;
+            capacities[slotRegions[slot]]++;
+        }
+        // Fixed random tie-break costs plus canonical input ordering make the
+        // same snapshot/options/seed reproducible even if callers reorder lists.
+        var noise = new double[slots.Length, slots.Length];
+        foreach (var item in movable)
+            foreach (var slot in movable) noise[item, slot] = random.NextDouble() * .35;
+        var best = Enumerable.Range(0, slots.Length).ToArray();
+        var bestScore = double.PositiveInfinity;
+        for (var attempt = 0; attempt < (movable.Length < 2 ? 1 : options.Attempts); attempt++)
+        {
+            var order = movable.ToArray();
+            random.Shuffle(order);
+            var assignment = Enumerable.Range(0, slots.Length).ToArray();
+            for (var i = 0; i < movable.Length; i++) assignment[movable[i]] = order[i];
+            var state = new SearchState(assignment, items, movable, slotRegions, regions, targetTypes,
+                capacities, noise, localTargetCount, firstTarget);
+            var score = state.Score();
+            if (score < bestScore) { bestScore = score; best = assignment.ToArray(); }
+            if (movable.Length < 2) break;
+            for (var step = 0; step < options.SwapsPerAttempt; step++)
+            {
+                var a = random.Next(movable.Length);
+                var b = random.Next(movable.Length - 1);
+                if (b >= a) b++;
+                var first = movable[a]; var second = movable[b];
+                state.Swap(first, second);
+                var next = state.Score();
+                var temperature = 2.5 * Math.Pow(.004, (double)step / Math.Max(1, options.SwapsPerAttempt - 1));
+                if (next <= score || random.NextDouble() < Math.Exp((score - next) / temperature))
+                {
+                    score = next;
+                    if (score < bestScore) { bestScore = score; best = assignment.ToArray(); }
+                }
+                else state.Swap(first, second);
+            }
+        }
+        var planned = slots.Select((slot, index) =>
+        {
+            var item = items[best[index]];
+            return new UpgradeDistributionAssignment(slot, item.Id, item.Kind,
+                pinned[index] ? UpgradePlacementRelation.Fixed : Relation(item, slot.Region));
+        }).ToArray();
+        // Validate the exact multiset, not just the number of distinct IDs.
+        var before = slots.GroupBy(s => s.OriginalUpgradeId, Codes).ToDictionary(g => g.Key, g => g.Count(), Codes);
+        var after = planned.GroupBy(s => s.UpgradeId, Codes).ToDictionary(g => g.Key, g => g.Count(), Codes);
+        if (before.Count != after.Count || before.Any(p => after.GetValueOrDefault(p.Key) != p.Value)
+            || planned.Where((_, i) => pinned[i]).Any(a => a.UpgradeId != a.Slot.OriginalUpgradeId))
+            throw new InvalidOperationException("The upgrade plan did not preserve its pool or fixed pickups.");
+        int Count(UpgradePlacementRelation relation) => planned.Count(a => a.Relation == relation);
+        var local = Count(UpgradePlacementRelation.SpecificLocal);
+        var elsewhere = Count(UpgradePlacementRelation.SpecificElsewhere);
+        var firstCode = regions.FirstOrDefault();
+        var firstShared = planned.Where(a => Codes.Equals(a.Slot.Region, firstCode)
+            && a.Relation is UpgradePlacementRelation.SharedLocal or UpgradePlacementRelation.SharedForeign).ToArray();
+        var notes = new List<string>();
+        if (local != localTargetCount)
+            notes.Add($"Same-region target {localTargetCount}/{eligible}; best sampled plan achieved {local}/{eligible}. Locality is a soft target, not a guaranteed optimum.");
+        var noLocalSlot = movable.Count(i => items[i].Specific && items[i].Homes.Count > 0
+            && !movable.Any(slot => items[i].Homes.Contains(slots[slot].Region)));
+        if (noLocalSlot > 0) notes.Add($"{noLocalSlot} truck-specific rewards have truck homes but no movable pickup slot in those regions.");
+        if (firstShared.Length == 0 && movable.Any(i => !items[i].Specific))
+            notes.Add("The selected plan has no movable shared upgrades in the first progression region; its foreign-shared preference could not contribute.");
+        if (firstCode is not null && firstTarget > 0 && movable.Any(i => !items[i].Specific)
+            && !movable.Any(i => !items[i].Specific && !items[i].Homes.Contains(firstCode)))
+            notes.Add("Every movable shared upgrade supports a truck in the first region; no foreign shared candidate exists there.");
+        if (slots.Length == 0) notes.Add("No pickup slots were supplied.");
+        var regional = regions.Select(region =>
+        {
+            var group = planned.Where(a => Codes.Equals(a.Slot.Region, region)).ToArray();
+            int N(UpgradePlacementRelation relation) => group.Count(a => a.Relation == relation);
+            return new UpgradeRegionDistribution(region, group.Length, TypeCounts(group.Select(a => a.Kind)),
+                N(UpgradePlacementRelation.SpecificLocal), N(UpgradePlacementRelation.SpecificElsewhere), N(UpgradePlacementRelation.SpecificWithoutHome),
+                N(UpgradePlacementRelation.SharedLocal), N(UpgradePlacementRelation.SharedForeign), N(UpgradePlacementRelation.Fixed));
+        }).ToArray();
+        return new(seed, planned, new(localTarget, localTargetCount, eligible, local, elsewhere,
+            Count(UpgradePlacementRelation.SpecificWithoutHome), Count(UpgradePlacementRelation.SharedLocal) + Count(UpgradePlacementRelation.SharedForeign),
+            Count(UpgradePlacementRelation.Fixed), firstCode, firstTarget, firstShared.Length,
+            firstShared.Count(a => a.Relation == UpgradePlacementRelation.SharedForeign), originalTypes,
+            TypeCounts(planned.Select(a => a.Kind)), regional, notes));
+    }
+
+    private static UpgradePlacementRelation Relation(Item item, string region) => item.Specific
+        ? item.Homes.Count == 0 ? UpgradePlacementRelation.SpecificWithoutHome
+            : item.Homes.Contains(region) ? UpgradePlacementRelation.SpecificLocal : UpgradePlacementRelation.SpecificElsewhere
+        : item.Homes.Contains(region) ? UpgradePlacementRelation.SharedLocal : UpgradePlacementRelation.SharedForeign;
+    private static Dictionary<UpgradeKind, int> TypeCounts(IEnumerable<UpgradeKind> types)
+    {
+        var counts = types.GroupBy(kind => kind).ToDictionary(group => group.Key, group => group.Count());
+        return Kinds.ToDictionary(kind => kind, kind => counts.GetValueOrDefault(kind));
+    }
+    private static string Key(UpgradeDistributionSlot slot) => string.Join('\u001f', slot.Source, slot.Map, slot.Zone, slot.RewardIndex.ToString(System.Globalization.CultureInfo.InvariantCulture));
+    private static bool Blank(params string[] values) => values.Any(string.IsNullOrWhiteSpace);
+    private static double Between(Random random, double min, double max) => min + random.NextDouble() * (max - min);
+    private static void ValidateOptions(UpgradeDistributionOptions options)
+    {
+        static bool Range(double min, double max) => double.IsFinite(min) && double.IsFinite(max) && min >= 0 && min <= max && max <= 1;
+        if (!Range(options.LocalMinimum, options.LocalMaximum)
+            || !Range(options.FirstRegionForeignSharedMinimum, options.FirstRegionForeignSharedMaximum)
+            || options.Attempts is < 1 or > 64 || options.SwapsPerAttempt is < 0 or > 200000)
+            throw new ArgumentOutOfRangeException(nameof(options), "Use probability ranges within 0–1, 1–64 attempts and 0–200000 swaps per attempt.");
+    }
+
+    private sealed class SearchState
+    {
+        private readonly int[] _assignment;
+        private readonly Item[] _items;
+        private readonly int[] _slotRegions;
+        private readonly string[] _regions;
+        private readonly int[,] _types;
+        private readonly int[,] _typeTargets;
+        private readonly int[] _shared;
+        private readonly int[] _sharedForeign;
+        private readonly int[] _withoutHome;
+        private readonly double[] _sharedTargets;
+        private readonly double[] _withoutHomeTargets;
+        private readonly double[,] _noise;
+        private readonly int _localTarget;
+        private readonly double _firstTarget;
+        private int _local;
+        private double _tieBreak;
+
+        public SearchState(int[] assignment, Item[] items, int[] movable, int[] slotRegions,
+            string[] regions, int[,] typeTargets, int[] capacities, double[,] noise, int localTarget, double firstTarget)
+        {
+            _assignment = assignment; _items = items; _slotRegions = slotRegions; _regions = regions;
+            _typeTargets = typeTargets; _noise = noise; _localTarget = localTarget; _firstTarget = firstTarget;
+            _types = new int[regions.Length, Kinds.Length];
+            _shared = new int[regions.Length]; _sharedForeign = new int[regions.Length]; _withoutHome = new int[regions.Length];
+            var shared = movable.Count(i => !items[i].Specific);
+            var withoutHome = movable.Count(i => items[i].Specific && items[i].Homes.Count == 0);
+            _sharedTargets = capacities.Select(n => movable.Length == 0 ? 0d : (double)shared * n / movable.Length).ToArray();
+            _withoutHomeTargets = capacities.Select(n => movable.Length == 0 ? 0d : (double)withoutHome * n / movable.Length).ToArray();
+            foreach (var slot in movable) Change(slot, assignment[slot], 1);
+        }
+
+        private void Change(int slot, int itemIndex, int direction)
+        {
+            var region = _slotRegions[slot]; var item = _items[itemIndex];
+            _types[region, (int)item.Kind] += direction;
+            _tieBreak += direction * _noise[itemIndex, slot];
+            switch (Relation(item, _regions[region]))
+            {
+                case UpgradePlacementRelation.SpecificLocal: _local += direction; break;
+                case UpgradePlacementRelation.SpecificWithoutHome: _withoutHome[region] += direction; break;
+                case UpgradePlacementRelation.SharedLocal: _shared[region] += direction; break;
+                case UpgradePlacementRelation.SharedForeign: _shared[region] += direction; _sharedForeign[region] += direction; break;
+            }
+        }
+
+        public void Swap(int first, int second)
+        {
+            var a = _assignment[first]; var b = _assignment[second];
+            Change(first, a, -1); Change(second, b, -1);
+            _assignment[first] = b; _assignment[second] = a;
+            Change(first, b, 1); Change(second, a, 1);
+        }
+
+        public double Score()
+        {
+            static double Square(double value) => value * value;
+            var score = 80 * Square(_local - _localTarget) + _tieBreak;
+            for (var region = 0; region < _regions.Length; region++)
+            {
+                for (var kind = 0; kind < Kinds.Length; kind++)
+                    score += 5 * Square(_types[region, kind] - _typeTargets[region, kind]) / (_typeTargets[region, kind] + 1);
+                // Prevent unrestricted/purchase-only parts and shared items from
+                // accumulating in one region simply because they are easy to place.
+                score += 2 * Square(_shared[region] - _sharedTargets[region]) / (_sharedTargets[region] + 1);
+                score += Square(_withoutHome[region] - _withoutHomeTargets[region]) / (_withoutHomeTargets[region] + 1);
+                if (region == 0)
+                    // This term has no truck-specific component: extra foreign
+                    // preference in the first region is exclusively for shared items.
+                    score += 18 * Square(_sharedForeign[region] - _firstTarget * _shared[region]) / Math.Max(1, _shared[region]);
+                else score += .15 * _sharedForeign[region];
+            }
+            return score;
+        }
+    }
+}
