+++ RegionTierListStore.cs
@@ -0,0 +1,48 @@
+using System.Text.Json;
+
+namespace SnowPakTool.Desktop;
+
+/// <summary>Region rankings are independent of truck tiers and custom truck groups.</summary>
+internal static class RegionTierListStore
+{
+    private static readonly string StateFile = Path.Combine(
+        Environment.GetFolderPath(Environment.SpecialFolder.LocalApplicationData),
+        "SnowPakTool.Desktop", "region-tiers.json");
+    private static readonly string[] Names = ["S", "A", "B", "C", "D"];
+
+    private sealed class RegionTierState
+    {
+        public string Name { get; set; } = string.Empty;
+        public List<string> RegionCodes { get; set; } = [];
+    }
+
+    public static List<GroupState> Load()
+    {
+        List<RegionTierState>? saved = null;
+        try
+        {
+            if (File.Exists(StateFile))
+                saved = JsonSerializer.Deserialize<List<RegionTierState>>(File.ReadAllText(StateFile));
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException) { }
+        // The shared tile board uses TruckCodes internally for both kinds of tile.
+        return Names.Select(name => new GroupState
+        {
+            Name = name,
+            TruckCodes = saved?.FirstOrDefault(tier => tier.Name == name)?.RegionCodes ?? []
+        }).ToList();
+    }
+
+    public static void Save(IReadOnlyList<GroupState> tiers)
+    {
+        Directory.CreateDirectory(Path.GetDirectoryName(StateFile)!);
+        var temporaryFile = StateFile + ".tmp";
+        var saved = Names.Select(name => new RegionTierState
+        {
+            Name = name,
+            RegionCodes = tiers.FirstOrDefault(tier => tier.Name == name)?.TruckCodes ?? []
+        });
+        File.WriteAllText(temporaryFile, JsonSerializer.Serialize(saved, new JsonSerializerOptions { WriteIndented = true }));
+        File.Move(temporaryFile, StateFile, overwrite: true);
+    }
+}
--- README.md
+++ README.md
@@ -19,6 +19,8 @@
 A simple Windows Forms frontend is in `src/SnowPakTool.Desktop`. Its first tab handles PAK unpacking, workspace merging, and repacking. The **Experience / Ranks** tab displays and edits the `rankExp` progression values in `[ps]/rank_settings.sso`, shows the 17-season maximum of 1,163,997 XP, provides a collapsible region XP checklist with a selected subtotal, and totals the current rank progression values needed to reach level 30. The updated XP progression uses an exponential curve, with a steepness slider beside the curve preview and an XP reduction slider below it; the reduction amount appears beneath that slider.
 
 All desktop tabs share one double-Shift text search with a three-character minimum. It searches the current tab and selected sub-tab, highlighting labels, values, table text and detail data without filtering rows. Enter focuses the first match; Esc, clicking elsewhere, or switching tabs/windows closes search.
+
+The **Region Tier List** tab ranks all regions found in the workspace in fixed S, A, B, C, and D tiers. It shares truck tier-list drag-and-drop, reordering, directional scrolling, palette colors, and search, with offline region thumbnails and season labels. Region rankings save automatically in their own file, independently of truck rankings.
 
